// Schema do banco de dados — organizado por bounded context via Postgres
// schemas (Prisma multiSchema). Ver docs/platform-architecture.md, seção 6,
// para o racional de adotar isso agora, antes da primeira migration real.
//
// identity                 -> Identity & Access (Tenant, User)
// catalog                  -> Catalog (Product, Supplier, TaxProfile, CatalogSettings)
// logistics_intelligence   -> Logistics Intelligence (LogisticsSettings)
// marketplace_intelligence -> Marketplace Intelligence (ver docs/marketplace-intelligence-architecture.md)
// integration_ops          -> infraestrutura genérica de sincronização externa
//                             (ProviderSyncSchedule/Log/Health), extraída do
//                             marketplace_intelligence na Etapa 5 porque o
//                             ERP Integration precisa do mesmo mecanismo
//                             (docs/erp-integration-architecture.md, seção 5).
// erp_integration          -> ERP Integration + conexão Nuvemshop (ver docs/erp-integration-architecture.md)
// channel_integration       -> Vínculo SKU x anúncio/produto em cada canal de venda
//                              (ChannelListing) — populado pelo erp-integration
//                              (hoje: Nuvemshop; amanhã: ML/Shopee), consumido
//                              pelo Pricing Intelligence.
// competition_intelligence -> Radar de concorrência (ver docs/competition-intelligence-architecture.md).
//                             Separa deliberadamente histórico append-only
//                             (CompetitorOfferSnapshot, para Analytics) do
//                             read-model enxuto que o Pricing Engine consulta
//                             (CompetitiveOpportunity) — mesma disciplina de
//                             ErpSyncChangeEvent (latest-state) vs. eventos
//                             de domínio (histórico), só que aqui os dois
//                             lados viraram tabelas físicas distintas porque
//                             o volume de leitura de concorrência é maior.
// financial_intelligence  -> DRE + Contas a Receber (FixedExpense, ReceivableRecord)
//                             — ver docs/financial-intelligence-architecture.md.
//                             Deliberadamente um bounded context PRÓPRIO, não
//                             uma extensão de catalog: DRE/fluxo de caixa é
//                             sobre a saúde financeira do NEGÓCIO como um
//                             todo (despesas recorrentes, repasses de
//                             marketplace), não sobre o cadastro de produto.
// orders                   -> Hub de pedidos multicanal (Order, OrderItem) —
//                             ver docs/orders-architecture.md. Status
//                             unificado (worklist estilo Olist); cada canal
//                             traz seu próprio vocabulário de status, mapeado
//                             para os 6 estágios canônicos no PRÓPRIO adapter
//                             (nunca no orquestrador genérico).
// logistics_fulfillment    -> Hub de Provas (auditoria de saída de estoque) +
//                             Full Fulfillment (Sprint 24, ver
//                             docs/logistics-fulfillment-architecture.md).
//                             Bounded context PRÓPRIO, distinto de
//                             logistics_intelligence (que só calcula peso
//                             cubado/de cobrança — nunca teve conceito de
//                             depósito ou movimentação de estoque). Unifica
//                             o despacho de varejo e o despacho para os CDs
//                             do Full atrás da MESMA garantia: nenhuma
//                             movimentação em StockLedgerEntry existe sem um
//                             StockMovementAuditEvent já APROVADO com mídia
//                             anexada. Sprint 27 (Pick & Pack) estendeu este
//                             mesmo schema com StockMovementAuditEventItem
//                             (checklist de bipagem) e VideoCaptureSession
//                             (captura de vídeo em chunks) — ver
//                             docs/pick-pack-architecture.md.
// promotion_intelligence  -> Motor de Cálculo de Margem para promoções
//                             (Sprint 26, ver docs/promotion-intelligence-architecture.md).
//                             Bounded context PRÓPRIO: valida a viabilidade
//                             de uma promoção ANTES dela existir de
//                             verdade, reaproveitando MarketplaceRule
//                             (fee) e CatalogSettings (política fiscal) —
//                             nunca duplica nenhum dos dois.
// marketplace_ads          -> Módulo de Ads multicanal, Fase 1 — leitura de
//                             campanhas e métricas (ver
//                             docs/marketplace-ads-architecture.md).
//                             Bounded context PRÓPRIO, distinto de
//                             marketplace_intelligence: ali vive a CONEXÃO
//                             OAuth2/credencial de cada canal (reaproveitada
//                             aqui via MercadoLivreAdsProvider), mas o dado
//                             de campanha/métrica de anúncio é um domínio
//                             diferente (performance de mídia paga, não
//                             regra de taxa/repricing). channelCode é um
//                             STRING solto (não FK para Marketplace), mesmo
//                             padrão de ChannelListing/OrderItem — permite
//                             registrar Shopee/TikTok/Amazon/Magalu depois
//                             sem nenhuma migration nova, só um provider novo
//                             implementando AdsCapableProvider.
// fiscal                   -> Emissão de NF-e (Fase 3, benchmark Tiny ERP,
//                             28/07/2026, ver docs/tiny-erp-benchmark-analysis.md,
//                             seção 1.1, e docs/fiscal-nfe-architecture.md).
//                             Integra com o Focus NFe (parceiro escolhido na
//                             Fase 0) — bounded context PRÓPRIO porque emitir
//                             nota fiscal é uma responsabilidade legal
//                             distinta de qualquer outro módulo, com seu
//                             próprio ciclo de vida assíncrono
//                             (PENDENTE -> PROCESSANDO -> AUTORIZADA/ERRO).
//                             orderId é referência SOLTA (não FK) para
//                             orders.Order — mesmo padrão de
//                             PurchaseOrder.supplierId (schemas diferentes).
// marketplace_publishing   -> Publicar anúncio novo em marketplace (Fase 4,
//                             benchmark Tiny ERP, 28/07/2026, ver
//                             docs/tiny-erp-benchmark-analysis.md, seção 1.7,
//                             e docs/marketplace-listing-publish-architecture.md).
//                             Modelo de categoria/atributo deliberadamente
//                             espelha o que o próprio usuário já usa e
//                             considera intuitivo no Tiny/Olist: árvore de
//                             categoria interna (catalog.ProductCategory) +
//                             atributos definidos POR CATEGORIA (não por
//                             produto), com herança opcional para categorias
//                             filhas (CategoryAttribute.extendToChildren) —
//                             e, SEPARADAMENTE, o mapeamento de cada
//                             categoria interna para a categoria de CADA
//                             canal (ChannelCategoryMapping, aqui, porque é
//                             dado específico de canal, não de catálogo).
//                             ListingPublication é append-only por
//                             tentativa de publicação (mesmo padrão de
//                             FiscalInvoice) — nunca automático: publicar um
//                             anúncio novo é uma ação real e cara de
//                             desfazer, sempre disparada por um clique
//                             explícito do usuário.
// freight_shipping         -> Etiqueta de envio avulsa (Fase 5, benchmark Tiny
//                             ERP, 29/07/2026 — ver
//                             docs/tiny-erp-benchmark-analysis.md, seção 1.2, e
//                             docs/dispatch-batch-architecture.md). Guarda só a
//                             CONEXÃO/credencial por tenant de transportadoras
//                             genéricas (Melhor Envio, Correios, Frenet) — o
//                             agrupamento de pedidos em si (DispatchBatch) vive
//                             em logistics_fulfillment, por ser uma extensão
//                             direta do Hub de Provas já existente (o mesmo
//                             racional de PURCHASE_RECEIPT na Fase 1: estender
//                             o bounded context existente em vez de duplicá-lo).
//                             providerCode é STRING solta (não enum), mesmo
//                             padrão de channelCode/marketplaceCode — permite
//                             registrar uma transportadora nova sem migration,
//                             só um provider novo implementando
//                             FreightLabelProvider.
// production                -> Ordens de Produção (Projeto Estruturante 1, benchmark
//                             Bling ERP, 29/07/2026, ver
//                             docs/bling-erp-benchmark-analysis.md, seção 1.1, e
//                             docs/production-architecture.md). BOM real
//                             (ProductStructureComponent, catalog — atributo do
//                             produto kit, mesmo racional de Packaging) +
//                             ProductionOrder/ProductionOrderComponent aqui, em
//                             schema PRÓPRIO: "produzir" é um processo distinto
//                             de "cadastrar produto" ou "mover estoque", com seu
//                             próprio workflow (RASCUNHO -> EM_ANDAMENTO ->
//                             CONCLUIDA/CANCELADA). Ao concluir, estende o Hub
//                             de Provas (logistics_fulfillment) com um novo tipo
//                             de evento (PRODUCTION_OUTPUT) — mesmo racional de
//                             PURCHASE_RECEIPT na Fase 1: nunca um caminho de
//                             escrita paralelo para StockLedgerEntry.
// Próximo schema (a criar quando o módulo existir): analytics.
// pricing_intelligence já existe como PRIMEIRA FATIA (simulador de margem
// Nuvemshop) — ver seção do módulo mais abaixo.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

// Deploy Demo (Render + Supabase) — ver docs/deploy-render-supabase-r2.md.
// `url` é a connection string do POOLER do Supabase (PgBouncer, modo
// Transaction, porta 6543) — usada em runtime pela aplicação, que abre/fecha
// conexões a cada requisição. `directUrl` é a connection DIRETA (porta 5432),
// usada só por `prisma migrate`/`prisma db push` — DDL transacional e
// advisory locks não funcionam de forma confiável atrás do PgBouncer em modo
// Transaction. Em dev local (docker-compose), as duas variáveis apontam para
// o mesmo Postgres — não há pooler local, então `DIRECT_URL` pode ser igual
// a `DATABASE_URL` sem problema.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["identity", "catalog", "logistics_intelligence", "marketplace_intelligence", "integration_ops", "erp_integration", "channel_integration", "competition_intelligence", "financial_intelligence", "orders", "logistics_fulfillment", "promotion_intelligence", "marketplace_ads", "tagging", "procurement", "fiscal", "marketplace_publishing", "freight_shipping", "production", "sellers"]
}

enum UserRole {
  ADMIN // acesso total, inclusive regras de margem mínima e integrações
  PRICING_EDITOR // pode editar produtos, margens e estratégias de repricing
  VIEWER // apenas leitura (dashboard e relatórios)

  @@schema("identity")
}

// Tenant = a conta de um vendedor/empresa. Toda tabela de negócio terá
// tenantId e será sempre filtrada por ele — mecanismo central de isolamento
// multi-tenant (docs/platform-architecture.md, seção 2).
model Tenant {
  id        String   @id @default(uuid())
  name      String
  document  String? // CNPJ, opcional no cadastro inicial
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("tenants")
  @@schema("identity")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  email        String
  passwordHash String
  role         UserRole @default(VIEWER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Único por tenant, não globalmente: duas contas diferentes podem ter
  // um usuário com o mesmo e-mail (ex.: um contador que atende várias lojas).
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
  @@schema("identity")
}

model Supplier {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  contact      String? // telefone/e-mail livre no MVP
  leadTimeDays Int?
  paymentTerms String? // condição de pagamento, texto livre no MVP
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products Product[]

  @@index([tenantId])
  @@map("suppliers")
  @@schema("catalog")
}

enum TaxRegime {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
  MEI
  OUTRO

  @@schema("catalog")
}

// Simplificação consciente (PRD, seções 3 e 9): não calcula ICMS-ST por
// estado nem faixa progressiva do Simples Nacional. Guarda uma alíquota
// estimada, reutilizável entre produtos.
model TaxProfile {
  id               String    @id @default(uuid())
  tenantId         String
  name             String // ex.: "Simples Nacional - Anexo I"
  regime           TaxRegime
  estimatedRatePct Float // alíquota estimada total (%), aplicada sobre o preço de venda
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  products Product[]

  @@index([tenantId])
  @@map("tax_profiles")
  @@schema("catalog")
}

// Fonte de um produto: cadastro manual (dono é a Precifica, todo campo
// editável) ou espelhado de um ERP externo (dono é o ERP para os campos
// físicos/comerciais — ver docs/erp-integration-architecture.md, seção 2).
// Union type de string no domínio; enum nominal aqui, mesmo padrão do resto
// do schema.
enum ProductSourceSystem {
  MANUAL
  ERP_OLIST

  @@schema("catalog")
}

model Product {
  id               String      @id @default(uuid())
  tenantId         String
  skuCode          String
  name             String
  internalCategory String?

  // Árvore de categoria estruturada (Fase 4, benchmark Tiny ERP, ver model
  // ProductCategory abaixo) — ADITIVO: internalCategory (texto livre) acima
  // continua existindo e não é preenchido automaticamente a partir deste
  // campo. categoryId é opcional porque é só pré-requisito de quem quer
  // publicar um anúncio novo em marketplace (Fase 4); um produto sem
  // categoryId continua 100% funcional em qualquer outro fluxo do Kyneti.
  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  supplierId       String?
  supplier         Supplier?   @relation(fields: [supplierId], references: [id])
  taxProfileId     String?
  taxProfile       TaxProfile? @relation(fields: [taxProfileId], references: [id])

  // Vínculo opcional com a embalagem cadastrada (Packaging Intel). Quando
  // presente: (a) o custo de aquisição efetivo usado pelo Pricing
  // Intelligence passa a ser costPrice + Packaging.costPrice — ver
  // ProductCatalogReader (shared/contracts/); (b) as dimensões/peso da
  // EMBALAGEM usadas no cálculo de peso cubado vêm de Packaging, não dos
  // campos lengthCm/widthCm/heightCm/packagingWeightKg abaixo — ver
  // domain/shipping-dimensions-resolver.ts. Nunca um campo travado por
  // sourceSystem (mesma razão do autoRepricingEnabled): é uma decisão
  // logística/estratégica da Precifica, não um fato espelhado do ERP.
  packagingId String?
  packaging   Packaging? @relation(fields: [packagingId], references: [id])

  // Sprint 26 (Motor de Margem de Promoções) — quando true, packagingId
  // acima deixa de significar "embalagem individual" e passa a significar
  // "Embalagem de Agrupamento" (Packaging.purpose = GROUPING) deste kit:
  // reaproveita o mesmo vínculo, sem campo novo, mesmo racional de qualquer
  // outra extensão econômica de entidade nesta base (ver
  // docs/promotion-intelligence-architecture.md). Default false: um
  // produto normal continua interpretando packagingId como hoje.
  isKit Boolean @default(false)

  // Controle de Lote/Validade (Projeto Estruturante 2, benchmark Bling ERP,
  // 29/07/2026 — ver docs/bling-erp-benchmark-analysis.md, seção 1.2, e
  // docs/product-lots-architecture.md). Default false: um produto normal
  // continua sem exigir lote. Quando true, ProductLot (abaixo) passa a
  // aceitar cadastro de lote para este skuCode, e StockLedgerEntry.lotCode
  // passa a ser preenchido nos lançamentos manuais por lote
  // (LOT_ADJUSTMENT) — mesmo racional aditivo de isKit: um flag no produto
  // que liga um comportamento em outro model, nunca um campo travado por
  // sourceSystem (é decisão operacional da Precifica, não fato físico
  // espelhado do ERP).
  controlaLote Boolean @default(false)

  // Produto Pai + Variação (Fase 2, benchmark Tiny ERP, 28/07/2026 — ver
  // docs/tiny-erp-benchmark-analysis.md, seção 2.3, e
  // docs/product-variants-architecture.md). Um único relacionamento
  // nullable resolve o conceito inteiro (decisão deliberada do benchmark:
  // NÃO replicar o par redundante tipoVariacao+produtoPai do Tiny) — se
  // parentProductId é null, o produto é "normal" OU um "pai" (ser pai é
  // estado DERIVADO de outros produtos apontarem pra ele via variants,
  // nunca um flag próprio gravado, mesmo racional de resolveEffectiveStatus
  // em outras entidades desta base). Hierarquia de UM nível só — uma
  // variação nunca pode ela mesma ter variantes (ver
  // domain/product-variant.ts, canSetParent) — por isso onDelete: SetNull,
  // não Cascade: apagar o pai nunca deveria arrastar a exclusão das
  // variações, que continuam sendo produtos vendáveis por si só.
  parentProductId String?
  parent          Product?  @relation("ProductVariants", fields: [parentProductId], references: [id], onDelete: SetNull)
  variants        Product[] @relation("ProductVariants")

  // Lista de Preços (Fase 2, benchmark Tiny ERP) — exceções de preço deste
  // produto em listas específicas (ex.: "Atacado", "Revenda"). Ver
  // model PriceListException abaixo e docs/price-lists-architecture.md.
  priceListExceptions PriceListException[]

  // Grade de atributos que diferencia esta variação das demais do mesmo pai
  // (ex.: {"cor": "Azul", "tamanho": "P"}) — JSON livre em vez de uma tabela
  // de atributos configurável: o benchmark despriorizou a implementação
  // exata do Tiny (GradeVariacaoResponseModel estruturado), e um objeto
  // chave/valor cobre o caso real (mostrar "Azul / P" na UI) sem exigir
  // cadastro prévio de "tipos de atributo". Só tem sentido quando
  // parentProductId != null — ver validateVariantAttributes.
  variantAttributes Json?

  costPrice Decimal @db.Decimal(12, 2) // custo do produto (sem embalagem) — ver Packaging acima para o custo efetivo

  // --- Margens (PRD, seção 1.2: dois campos, não um) ---
  desiredMarginPct Float // margem desejada (%) — define o preço ideal
  minimumMarginPct Float // margem mínima aceitável (%) — define o preço mínimo, piso de segurança

  // Política de Preço Mínimo Anunciado (MAP) — piso definido pelo
  // FORNECEDOR/MARCA, não calculado a partir de custo/margem como os dois
  // campos acima. Nullable de verdade (não @default(0)): null = "sem
  // restrição MAP para este SKU", 0 seria um valor de piso ambíguo (preço
  // zero nunca é uma política de MAP real). Não é campo travado por
  // sourceSystem (mesma razão de autoRepricingEnabled/isKit): é uma decisão
  // comercial/contratual da Precifica com o fornecedor, não um fato físico
  // espelhado do ERP — continua editável mesmo em produtos ERP_OLIST.
  // Toda mudança neste campo é auditada — ver model ProductAuditLog abaixo
  // e domain/product-audit.ts (diffGovernanceFields).
  mapPrice Decimal? @db.Decimal(12, 2)

  // Modo operação do PricingStrategist (docs/pricing-intelligence-architecture.md,
  // seção 7): false = PricingDecisionService só calcula e loga a sugestão;
  // true = dispara PRICE_UPDATE_DISPATCHER automaticamente quando reage a um
  // sinal de concorrência. Default false de propósito — automação de preço
  // real é opt-in por SKU, nunca ligada por padrão. Não é campo travado por
  // sourceSystem (ver product-ownership-rules.ts): é estratégia de
  // precificação da Precifica, não um fato físico do produto, então
  // continua editável mesmo em produtos espelhados do ERP.
  autoRepricingEnabled Boolean @default(false)

  // --- Fatos físicos brutos (Catalog é dono, exceto quando sourceSystem = ERP_OLIST) ---
  weightKg          Float // peso do produto sem embalagem
  packagingWeightKg Float @default(0) // peso da embalagem
  packedWeightKg    Float // = weightKg + packagingWeightKg

  lengthCm Float
  widthCm  Float
  heightCm Float

  // --- Calculados pelo Logistics Intelligence via porta ShippingWeightCalculator ---
  // (docs/platform-architecture.md, seção 10.1) — Catalog só persiste o resultado.
  cubicWeightKg    Float
  shippingWeightKg Float

  // --- Campos fiscais (benchmark Tiny ERP, 28/07/2026 — ver
  // docs/tiny-erp-benchmark-analysis.md, seções 1.1/2.1) — pré-requisito
  // para emissão de NF-e (Fase 3 do roadmap) e para publicar anúncio novo
  // em marketplace (Fase 4), que exigem NCM/GTIN. Deliberadamente EDITÁVEIS
  // em qualquer sourceSystem por enquanto (não entraram em ERP_OWNED_FIELDS,
  // ver product-ownership-rules.ts) — diferente de weightKg/lengthCm etc.,
  // nenhum sync do Olist popula estes campos ainda; travar agora deixaria o
  // campo permanentemente null e não editável para produtos ERP_OLIST. Isso
  // é revisitado quando o sync de fato passar a trazer esses dados.
  ncm              String? // Nomenclatura Comum do Mercosul — classificação fiscal do produto
  gtin             String? // código de barras (EAN/GTIN)
  fiscalOriginCode Int? // origem da mercadoria para ICMS (0-8, tabela do Tiny/SEFAZ) — ver ObterProdutoModelResponse.origem no benchmark
  // CEST (benchmark Bling, 29/07/2026, docs/bling-erp-benchmark-analysis.md,
  // seção 2) — obrigatório na NF-e de item sujeito a Substituição Tributária
  // (eletrônicos, cosméticos, autopeças, bebidas etc.). null é válido: nem
  // todo produto tem ST. Mesmo racional de editabilidade do bloco acima.
  cest             String?

  // --- Estoque e proveniência (Etapa 5 — ver docs/erp-integration-architecture.md, seção 2) ---
  stockQuantity Int @default(0) // não existia antes do ERP Integration revelar a lacuna

  // Preço de venda que está hoje no Olist — puramente informativo, não tem
  // relação com o motor de precificação da Precifica (que calcula o próprio
  // preço ideal/mínimo). Fica só para comparação/auditoria na UI.
  erpSalePrice Decimal? @db.Decimal(12, 2)

  // URLs finais servidas pela Precifica (mirror local ou, depois, S3/R2) —
  // nunca a URL original do Olist direto na cara do usuário (shared/contracts/file-storage.port.ts).
  photoUrls String[] @default([])

  sourceSystem ProductSourceSystem @default(MANUAL)
  externalId   String? // id do produto no sistema de origem (ex.: id do Olist) — null quando MANUAL
  lastSyncedAt DateTime? // último upsert bem-sucedido vindo do ERP — null quando MANUAL

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, skuCode])
  @@unique([tenantId, sourceSystem, externalId])
  @@index([tenantId])
  // Consulta mais comum da grade de variações: "todos os filhos deste pai" —
  // ver ProductRepository.findChildren.
  @@index([tenantId, parentProductId])
  @@index([tenantId, categoryId])
  @@map("products")
  @@schema("catalog")
}

// ============================================================================
// Árvore de categoria de produto + atributos por categoria (Fase 4, benchmark
// Tiny ERP, 28/07/2026 — ver docs/tiny-erp-benchmark-analysis.md, seção 1.7,
// e docs/marketplace-listing-publish-architecture.md). Espelha
// deliberadamente o modelo "Categorias dos Produtos" do Tiny/Olist
// (confirmado com o usuário como o padrão a seguir): grupos de categoria +
// subcategorias, com atributos (ficha técnica: cor, material, voltagem...)
// vinculados à CATEGORIA, não ao produto individual — um produto herda os
// atributos da sua categoria (e, opcionalmente, da categoria pai, quando
// CategoryAttribute.extendToChildren = true na categoria pai).
// ============================================================================

model ProductCategory {
  id       String @id @default(uuid())
  tenantId String
  name     String

  // Hierarquia de profundidade livre (diferente do único nível de
  // Product.parentProductId) — o Tiny modela "grupo de categorias" +
  // "subcategorias" dentro do grupo, o que já é 2 níveis; não há razão de
  // negócio para travar em um número fixo de níveis aqui, então
  // parentCategoryId aceita qualquer profundidade. Validação de ciclo
  // (uma categoria nunca pode ser sua própria ancestral) é responsabilidade
  // da aplicação (ProductCategoryService), não do schema.
  parentCategoryId String?
  parent           ProductCategory?  @relation("CategoryTree", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  children         ProductCategory[] @relation("CategoryTree")

  attributes CategoryAttribute[]
  products   Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, parentCategoryId])
  @@map("product_categories")
  @@schema("catalog")
}

// "Informar atributos por categoria" do Tiny/Olist — ficha técnica anexada a
// UMA categoria (ex.: "tipo de manga", "voltagem"), reutilizada por todo
// produto daquela categoria. attributeValue aqui é o DEFAULT da categoria —
// quem publica um anúncio (Fase 4) pode sempre sobrepor no momento da
// publicação (ex.: cor varia por produto mesmo dentro da mesma categoria);
// este model nunca é a fonte de verdade final, só o ponto de partida.
model CategoryAttribute {
  id         String          @id @default(uuid())
  tenantId   String
  categoryId String
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  attributeName  String
  attributeValue String

  // Quando true, esta categoria propaga este atributo para TODAS as
  // categorias filhas (recursivamente) — mesmo racional do "Estender
  // atributos para categorias filhas" do Tiny. Resolvido pela função pura
  // resolveEffectiveAttributes (domain/), nunca calculado no banco.
  extendToChildren Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, attributeName])
  @@index([tenantId, categoryId])
  @@map("category_attributes")
  @@schema("catalog")
}

// ============================================================================
// BOM real — Produtos-Estrutura (Projeto Estruturante 1, benchmark Bling ERP,
// 29/07/2026, ver docs/bling-erp-benchmark-analysis.md, seção 1.1, e
// docs/production-architecture.md). Atributo do produto kit (Product.isKit =
// true), mesmo racional de Packaging: cadastro em catalog, consumido por
// outro módulo (aqui, production.ProductionOrder monta um snapshot a partir
// disto). Decisão de escopo deliberada: este model descreve SÓ a
// COMPOSIÇÃO (o que entra em 1 unidade do kit) — NÃO decide COMO a venda do
// kit baixa estoque (isso continua via RETAIL_SHIPMENT normal, sem alteração
// nesta rodada; ver docs/production-architecture.md para o racional
// completo de por que esse escopo foi deliberadamente deixado de fora).
// ============================================================================

model ProductStructureComponent {
  id       String @id @default(uuid())
  tenantId String

  // Referências SOLTAS por SKU (não FK para Product.id) — mesmo padrão de
  // StockLedgerEntry.skuCode/PurchaseOrderItem.skuCode em toda esta base:
  // permite compor a partir de um código ainda não resolvido num Product.id
  // específico no momento da leitura, e evita acoplar este model à PK
  // interna do catálogo.
  parentSkuCode    String // SKU do produto kit (Product.isKit = true)
  componentSkuCode String // SKU do componente consumido

  // Decimal (não Int) — permite componente fracionário por unidade do kit
  // (ex.: 0.5kg de um insumo a granel por unidade produzida).
  quantity Decimal @db.Decimal(12, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Um componente não pode aparecer duas vezes na mesma estrutura — mesma
  // linha, quantidade somada, nunca duas linhas para o mesmo par.
  @@unique([tenantId, parentSkuCode, componentSkuCode])
  @@index([tenantId, parentSkuCode])
  @@map("product_structure_components")
  @@schema("catalog")
}

// ============================================================================
// Produtos-Lotes (rastreamento de lote/validade, FEFO) — Projeto Estruturante
// 2, benchmark Bling ERP, 29/07/2026 (docs/bling-erp-benchmark-analysis.md,
// seção 1.2 — LotesDTO). Metadado do lote em si (data de fabricação/validade,
// regra de bloqueio de venda) — o SALDO por lote não vive aqui, é derivado de
// StockLedgerEntry.lotCode (abaixo), mesmo racional de saldo de SKU (nunca
// duplica um contador que o ledger já responde). Ver
// docs/product-lots-architecture.md para o racional completo.
// ============================================================================

enum ProductLotStatus {
  ATIVO
  INATIVO

  @@schema("catalog")
}

model ProductLot {
  id       String @id @default(uuid())
  tenantId String

  // Referência SOLTA por SKU (não FK para Product.id) — mesmo padrão de
  // ProductStructureComponent acima e de StockLedgerEntry.skuCode.
  skuCode  String // Product.controlaLote precisa ser true (validado na aplicação, não no schema)
  lotCode  String // "codigoLote" do Bling — identificador do lote, único por SKU

  dataFabricacao DateTime?
  dataValidade   DateTime

  // Dias antes do vencimento em que o lote para de poder ser vendido — ex.:
  // 30 = bloqueia a venda 30 dias antes de dataValidade. 0 = só bloqueia
  // depois de vencido de fato. Ver domain/product-lot.ts, isLotSellable.
  diasPermitidoVenda Int @default(0)

  // "codigoAgregacao" do Bling — código de pallet/agregação física, puramente
  // informativo (não participa de nenhuma regra de negócio hoje).
  codigoAgregacao String?

  status ProductLotStatus @default(ATIVO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Um SKU não pode ter dois lotes com o mesmo código.
  @@unique([tenantId, skuCode, lotCode])
  @@index([tenantId, skuCode])
  // Consulta da tela de gestão de lote: "quais lotes vencem em breve" —
  // varre por tenant + data, sem depender do SKU.
  @@index([tenantId, dataValidade])
  @@map("product_lots")
  @@schema("catalog")
}

// ============================================================================
// Packaging Intel — cadastro de embalagens, reutilizável entre produtos (um
// tipo de caixa/envelope serve para vários SKUs). Ver
// docs/pricing-intelligence-architecture.md, seção 9, para como isso entra
// no custo e no peso cubado.
//
// Unidade de peso deliberadamente diferente do resto do schema: Product usa
// Kg (weightKg, packagingWeightKg) porque descreve o produto físico, que
// tipicamente pesa unidades de Kg; embalagem (papelão, plástico-bolha,
// envelope) é especificada pelo fornecedor em GRAMAS na prática — manter
// weightG explícito evita o erro de digitar "0.015" (15g) num campo que
// todo o resto do sistema assume estar em Kg. A conversão para Kg acontece
// uma vez, na borda, em resolveShippingDimensions.
// ============================================================================

// Sprint 26 (Motor de Margem de Promoções) — hierarquia de resolução de
// custo logístico de embalagem, ver docs/promotion-intelligence-architecture.md:
// STANDARD (comportamento de sempre, embalagem individual de 1 SKU),
// GROUPING (embalagem de um kit/combo, vinculada via Product.isKit=true),
// MASTER (caixa maior usada quando vários SKUs avulsos vão no mesmo
// despacho — seleção por cubagem total, ainda não consumida por nenhum
// serviço nesta sprint), SAFETY_DEFAULT (fallback conservador quando nada
// mais resolve — no máximo uma linha ativa por tenant, validado na
// aplicação, nunca como constraint de banco).
enum PackagingPurpose {
  STANDARD
  GROUPING
  MASTER
  SAFETY_DEFAULT

  @@schema("catalog")
}

model Packaging {
  id            String   @id @default(uuid())
  tenantId      String
  name          String // ex.: "Caixa papelão 20x15x10"
  weightG       Float // peso da embalagem vazia, em GRAMAS
  heightCm      Float
  widthCm       Float
  lengthCm      Float
  costPrice     Decimal  @db.Decimal(12, 2) // custo unitário da embalagem — mesmo nome/convenção de Product.costPrice
  stockQuantity Int      @default(0)
  isActive      Boolean  @default(true)

  purpose PackagingPurpose @default(STANDARD)
  // Só relevante quando purpose = MASTER: capacidade máxima (peso, em Kg)
  // que essa caixa aguenta — usada pela futura seleção de Embalagem Master
  // por cubagem total do pedido (Prioridade 2 da hierarquia). Nulo em
  // qualquer outro purpose.
  maxCapacityKg Float?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products      Product[]
  usageEvents   PackagingUsageEvent[]

  @@index([tenantId])
  @@index([tenantId, purpose])
  @@map("packagings")
  @@schema("catalog")
}

// Log de CONSUMO de embalagem — para o futuro DRE/Analytics (custo de
// embalagem gasto num período), NÃO para o Pricing Engine (que sempre lê o
// custo ATUAL de Packaging.costPrice via ProductCatalogReader, nunca um
// histórico). Append-only, uma linha por unidade vendida.
//
// HONESTIDADE TÉCNICA: não existe hoje, neste projeto, um módulo de
// Vendas/Pedidos que dispare isso automaticamente quando "um produto é
// vendido" — essa tabela e o serviço de escrita associado (Etapa deste
// módulo) existem como MECANISMO pronto (schema + porta + endpoint manual),
// não como um pipeline automático. Quando um módulo de Vendas existir, ele
// chama PackagingUsageEventsService.record(...) no mesmo lugar em que
// confirma uma venda — nada aqui precisa mudar.
//
// unitCostPrice é uma CÓPIA CONGELADA do custo no momento do evento, não
// uma referência a Packaging.costPrice — o custo da embalagem pode mudar
// depois (reajuste de fornecedor), e o DRE de um período passado precisa
// do custo histórico real, não do custo de hoje.
model PackagingUsageEvent {
  id            String    @id @default(uuid())
  tenantId      String
  productId     String // referência solta (não FK) — mesmo padrão de ChannelListing/CompetitiveOpportunity: histórico de DRE não deve ficar acoplado ao ciclo de vida do Product
  packagingId   String
  packaging     Packaging @relation(fields: [packagingId], references: [id])
  quantity      Int       @default(1)
  unitCostPrice Decimal   @db.Decimal(12, 2)
  occurredAt    DateTime  @default(now())

  @@index([tenantId, productId, occurredAt])
  @@index([tenantId, packagingId, occurredAt])
  @@map("packaging_usage_events")
  @@schema("catalog")
}

// Configuração de catálogo por tenant — hoje só as margens padrão aplicadas
// a produtos recém-importados do ERP (o Olist não tem esse conceito).
// Mesmo padrão do LogisticsSettings.cubicWeightFactor: default sensato,
// editável sem precisar de deploy.
model CatalogSettings {
  tenantId                 String   @id
  defaultDesiredMarginPct  Float    @default(20)
  defaultMinimumMarginPct  Float    @default(8)

  // Governança financeira (Pricing Intelligence, "modo operação" — ver
  // docs/pricing-intelligence-architecture.md, seção 8). Diferente de
  // defaultMinimumMarginPct acima (piso POR SKU, aplicado só a produtos
  // recém-importados sem margem definida): estes dois campos são um piso
  // GLOBAL do tenant, sempre em vigor, independente do que cada produto
  // configura. Guardados como percentual (0-100, mesma convenção do resto
  // do schema); convertidos para fração na porta FinancialPolicyReader
  // (shared/contracts/) porque é assim que a fórmula do piso financeiro
  // (FloorPrice = custo / (1 - (taxa + margem))) é expressa.
  taxRatePct        Float @default(0) // alíquota efetiva estimada (%) — 0 até o tenant configurar
  minProfitMarginPct Float @default(0) // margem líquida mínima global (%) — 0 até o tenant configurar

  // Meta de ROAS do tenant (Ads — Fase 4, sugestão via IA). Diferente de
  // taxRatePct/minProfitMarginPct acima: 0 não é um default seguro aqui (ROAS
  // meta 0 significaria "qualquer retorno serve", o oposto da intenção) —
  // por isso nullable de verdade, não @default(0). null = "tenant não
  // configurou uma meta própria ainda"; FinancialPolicyReaderService resolve
  // para DEFAULT_ROAS_HEALTHY_THRESHOLD (domain/ads-metrics.ts) nesse caso,
  // nunca este model nem nenhum outro consumidor decide o fallback sozinho.
  targetRoas Float?

  updatedAt                DateTime @updatedAt

  @@map("catalog_settings")
  @@schema("catalog")
}

// Trilha de auditoria de campos de GOVERNANÇA do Product — hoje só
// mapPrice (Política de Preço Mínimo). HONESTIDADE TÉCNICA: não existia
// nenhum mecanismo de auditoria genérico neste projeto antes deste model —
// ErpSyncChangeEvent (erp_integration) audita só o diff de sync do ERP,
// MarketplaceChangeEvent (marketplace_intelligence) só mudança de regra de
// marketplace, StockMovementAuditEvent (logistics_fulfillment) é prova de
// SAÍDA DE ESTOQUE físico — nenhum dos três serve para "usuário X mudou o
// campo Y do produto Z, de A para B, às HH:MM". Este model é novo,
// propositalmente ESCOPADO a campos de governança do Product (não uma
// tabela genérica "audite qualquer coisa") — mesma disciplina de não
// genericizar prematuramente já usada no resto da plataforma; `field` é
// string livre para acomodar outros campos de governança no futuro sem
// migration nova, mas o consumidor (ProductAuditLogService) só grava para
// os campos em GOVERNANCE_AUDITED_FIELDS (domain/product-audit.ts).
enum ProductAuditSource {
  MANUAL // editado via PATCH /products/:id
  BULK_IMPORT // aplicado via POST /products/bulk-import/map-price

  @@schema("catalog")
}

model ProductAuditLog {
  id        String @id @default(uuid())
  tenantId  String
  productId String
  // Desnormalizado de propósito (mesmo padrão de ReceivableRecord.skuCode/
  // ChannelListing.skuCode): a trilha de auditoria precisa sobreviver e
  // continuar legível mesmo que o produto seja removido depois — nunca uma
  // FK com cascade que apagaria o histórico junto.
  skuCode String

  field String // "mapPrice" hoje — ver comentário acima do model

  // Serializados como string — o valor pode ser Decimal/Boolean/etc
  // dependendo do campo, e esta tabela nunca tenta ser fortemente tipada
  // por campo (isso é responsabilidade de quem grava, não do schema).
  // Ambos nullable porque tanto "estava sem MAP" (oldValue null) quanto
  // "MAP removido" (newValue null) são estados legítimos.
  oldValue String?
  newValue String?

  source          ProductAuditSource
  changedByUserId String // sempre preenchido — toda mutação (manual ou bulk import) passa por um usuário autenticado, nunca um processo anônimo
  changedAt       DateTime @default(now())

  @@index([tenantId, productId, changedAt])
  @@index([tenantId, field, changedAt])
  @@map("product_audit_logs")
  @@schema("catalog")
}

// Configuração de logística por tenant. Extraída do Catalog (onde vivia como
// Tenant.cubicWeightFactor) porque é uma REGRA de negócio, não um fato do
// produto — pertence ao módulo que sabe transformar peso/dimensão em custo
// de frete, não ao módulo que apenas descreve o produto.
model LogisticsSettings {
  tenantId          String   @id
  cubicWeightFactor Int      @default(6000)
  updatedAt         DateTime @updatedAt

  @@map("logistics_settings")
  @@schema("logistics_intelligence")
}

// ============================================================================
// Marketplace Intelligence — ver docs/marketplace-intelligence-architecture.md
// ============================================================================

// Marketplace é dado, não enum: adicionar um canal novo é inserir uma linha,
// nunca uma migration (seção 2.1 do documento de arquitetura do módulo).
model Marketplace {
  id          String   @id @default(uuid())
  code        String   @unique // "MERCADO_LIVRE", "SHOPEE", ...
  displayName String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  rules        MarketplaceRule[]
  changeEvents MarketplaceChangeEvent[]

  @@map("marketplaces")
  @@schema("marketplace_intelligence")
}

enum RuleType {
  FEE_RULE
  SHIPPING_POLICY
  CATEGORY_TAXONOMY

  @@schema("marketplace_intelligence")
}

enum DataSourceType {
  OFFICIAL_API
  OFFICIAL_DOCS
  IMPORTED_FILE
  MANUAL

  @@schema("marketplace_intelligence")
}

enum RuleStatus {
  PENDENTE_VALIDACAO
  VALIDADA
  DESATUALIZADA
  OBSOLETA

  @@schema("marketplace_intelligence")
}

// Tabela única e versionada para qualquer tipo de regra de marketplace — a
// mecânica de versionamento/status/auditoria é idêntica independente do
// conteúdo; só o payload muda (seção 2.2 do documento de arquitetura do módulo).
model MarketplaceRule {
  id            String      @id @default(uuid())
  marketplaceId String
  marketplace   Marketplace @relation(fields: [marketplaceId], references: [id])

  ruleType RuleType
  scopeKey String // categoria externa (FEE_RULE), identificador de política (SHIPPING_POLICY), etc.

  payload Json // validado por RulePayloadValidator do ruleType antes de persistir — nunca gravado cru

  version Int
  status  RuleStatus @default(PENDENTE_VALIDACAO)

  // Override manual sempre vence conflito, independente da prioridade de
  // fonte (seção 6 do documento de arquitetura do módulo).
  pinned Boolean @default(false)

  sourceType         DataSourceType
  sourceProviderCode String
  sourceFetchedAt    DateTime
  sourceEvidenceRef  String?

  contentHash String // hash do payload normalizado — usado para diff/dedupe no pipeline de sync

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  validatedById String?
  validatedAt   DateTime?

  // null = regra global da plataforma (ex.: tabela pública de comissão do ML).
  // preenchido = override específico de um tenant.
  tenantId String?

  createdAt DateTime @default(now())

  @@unique([marketplaceId, ruleType, scopeKey, version, tenantId])
  @@index([marketplaceId, ruleType, scopeKey, status])
  @@map("marketplace_rules")
  @@schema("marketplace_intelligence")
}

enum ChangeResolution {
  AUTO_APPLIED
  PENDING_REVIEW
  REJECTED
  APPLIED_MANUALLY

  @@schema("marketplace_intelligence")
}

model MarketplaceChangeEvent {
  id            String      @id @default(uuid())
  marketplaceId String
  marketplace   Marketplace @relation(fields: [marketplaceId], references: [id])
  ruleType      RuleType
  scopeKey      String

  previousRuleId String?
  newRuleId      String

  changeSummary      String
  detectedByProvider String
  detectedAt         DateTime @default(now())

  resolutionStatus ChangeResolution @default(PENDING_REVIEW)
  reviewedById     String?
  reviewedAt       DateTime?

  @@index([marketplaceId, detectedAt])
  @@map("marketplace_change_events")
  @@schema("marketplace_intelligence")
}

// Sprint 22 — conexão OAuth2 por vendedor do Mercado Livre. Mesmo racional de
// NuvemshopConnection/OlistConnection (erp_integration): um registro por
// tenant, credenciais SEMPRE criptografadas em repouso
// (CredentialEncryptionService, ver docs/auth-security.md). Vive no schema
// marketplace_intelligence (não erp_integration) porque é aqui que
// MercadoLivreApiClient/MercadoLivreOrderProvider/MercadoLivreFeeRuleProvider
// já moram desde a Etapa 4/Sprint 21 — o módulo dono da integração também é
// o dono da credencial, mesmo padrão de propriedade usado em todo o resto
// da plataforma.
//
// Diferença estrutural para NuvemshopConnection: Nuvemshop usa um token
// estático de app privado (nunca expira sozinho); Mercado Livre é OAuth2
// completo — por isso os campos extras `refreshTokenEnc`/`expiresAt`/
// `scope`/`sellerId` (identificador do vendedor devolvido pela troca do
// `code`, necessário em toda chamada a `/orders/search?seller=`).
model MercadoLivreConnection {
  tenantId String @id

  // ID numérico do vendedor no Mercado Livre — devolvido no token exchange
  // (campo `user_id` da resposta de /oauth/token), não escolhido por nós.
  sellerId String

  accessTokenEnc  String // criptografado em repouso (CredentialEncryptionService)
  refreshTokenEnc String // idem — permite renovar sem novo login do vendedor
  tokenType       String  @default("bearer")
  scope           String? // escopos concedidos pelo vendedor na tela de autorização do ML

  // Quando o access_token expira (agora + expires_in da resposta do ML,
  // tipicamente 6h) — o gate que MercadoLivreConnectionService.getValidAccessToken
  // usa para decidir se renova antes de qualquer chamada à API.
  expiresAt DateTime

  isActive        Boolean   @default(true)
  lastRefreshedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("mercado_livre_connections")
  @@schema("marketplace_intelligence")
}

// Integração Shopee Open Platform (27/07/2026) — mesmo racional estrutural
// de MercadoLivreConnection acima (um registro por tenant, credenciais
// SEMPRE criptografadas em repouso via CredentialEncryptionService), mas
// para um mecanismo de auth diferente: Shopee não usa OAuth2 "clássico"
// (RFC 6749) com client_id/client_secret — usa HMAC-SHA256 sobre
// partner_id+path+timestamp com uma partner_key de APP (ver
// ShopeeApiClient). shopId é o equivalente ao sellerId do ML: identificador
// da LOJA (não do vendedor em si) devolvido no redirect de autorização e
// confirmado na troca do `code`, necessário em toda chamada autenticada.
//
// AVISO DE HONESTIDADE: mesmo padrão de toda integração nova deste projeto
// — o fluxo abaixo segue a documentação pública do Shopee Open Platform
// (partner.shopeemobile.com) e guias de terceiros (não foi possível ler a
// documentação oficial completa, renderizada via JS, a partir deste
// sandbox), e NUNCA foi exercitado contra uma chamada real (app em status
// "Developing", só com credenciais de TESTE). Ver ShopeeApiClient para o
// detalhamento exato do que está e não está validado.
model ShopeeConnection {
  tenantId String @id

  // ID numérico da loja Shopee — devolvido como `shop_id` no redirect de
  // /api/v2/shop/auth_partner e confirmado na resposta de /auth/token/get.
  shopId String

  accessTokenEnc  String // criptografado em repouso (CredentialEncryptionService)
  refreshTokenEnc String // idem — permite renovar sem nova autorização do lojista

  // Quando o access_token expira (agora + expire_in da resposta do Shopee,
  // tipicamente 4h — MAIS CURTO que o do Mercado Livre, ~6h). O
  // refresh_token em si expira em ~1 mês (Shopee); se a renovação falhar
  // depois disso, o lojista precisa reautorizar do zero (mesmo tratamento
  // de falha usado em MercadoLivreConnectionService: alerta ERROR, nunca
  // silencioso).
  expiresAt DateTime

  isActive        Boolean   @default(true)
  lastRefreshedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("shopee_connections")
  @@schema("marketplace_intelligence")
}

// ============================================================================
// Integration Ops — infraestrutura genérica de sincronização com fontes
// externas (scheduler, log, health). Vivia dentro de marketplace_intelligence
// até a Etapa 5; extraída para cá porque o ERP Integration precisa do MESMO
// mecanismo e nada aqui é específico de marketplace (docs/erp-integration-architecture.md,
// seção 5). Nenhum comportamento do Marketplace Intelligence muda — só o
// endereço das tabelas.
// ============================================================================

model ProviderSyncSchedule {
  id           String @id @default(uuid())
  providerCode String @unique

  // Referência solta (não FK) para o que este provider sincroniza — ex.: o
  // id de uma Marketplace, ou um valor fixo como "ERP_OLIST". Deixou de ser
  // uma relação Prisma de propósito: esta tabela agora é compartilhada por
  // módulos que não têm o conceito de Marketplace.
  marketplaceId String

  capability      String // "FEE_RULES" | "SHIPPING_POLICY" | "CATEGORY_TAXONOMY" | "ERP_CATALOG"
  intervalMinutes Int
  isEnabled       Boolean   @default(true)
  autoTrust       Boolean   @default(false) // se true, candidatos são promovidos direto a VALIDADA (só se aplica a Marketplace Intelligence)
  lastRunAt       DateTime?
  lastRunStatus   String?

  @@map("provider_sync_schedules")
  @@schema("integration_ops")
}

model ProviderSyncLog {
  id                String    @id @default(uuid())
  providerCode      String
  correlationId     String
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  status            String // SUCCESS | FAILED | PARTIAL
  candidatesFound   Int       @default(0)
  candidatesApplied Int       @default(0)
  errorDetails      String?

  @@index([providerCode, startedAt])
  @@map("provider_sync_logs")
  @@schema("integration_ops")
}

model ProviderHealth {
  providerCode        String    @id
  status              String // UP | DEGRADED | DOWN
  consecutiveFailures Int       @default(0)
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  lastError           String?
  updatedAt           DateTime  @updatedAt

  @@map("provider_health")
  @@schema("integration_ops")
}

// ============================================================================
// ERP Integration — ver docs/erp-integration-architecture.md
// ============================================================================

// Uma linha por tenant: as credenciais para consumir a API do Olist Tiny em
// nome dele. Token estático (API V2) — ver seção 8 do doc de arquitetura
// para o porquê de V2 em vez de V3/OAuth2 nesta primeira entrega.
model OlistConnection {
  tenantId     String    @id
  apiTokenEnc  String // criptografado em repouso
  isActive     Boolean   @default(true)
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("olist_connections")
  @@schema("erp_integration")
}

model ErpSyncChangeEvent {
  id            String   @id @default(uuid())
  tenantId      String
  externalId    String // id do produto no Olist
  skuCode       String
  changeSummary String // diff legível
  action        String // CREATED | UPDATED | UNCHANGED
  contentHash   String // hash do payload normalizado — usado para diff no próximo sync (shared/domain/content-hash.ts)
  syncedAt      DateTime @default(now())

  @@unique([tenantId, externalId])
  @@index([tenantId, syncedAt])
  @@map("erp_sync_change_events")
  @@schema("erp_integration")
}

// Nuvemshop entrou no escopo por decisão sua: é a loja própria, o motor de
// preço precisa calcular a margem dela com o mesmo rigor dos marketplaces.
// Estruturalmente ela não é um ERP (não é fonte de cadastro read-only do
// catálogo) — é um CANAL DE VENDA, igual Mercado Livre/Shopee. A credencial
// mora aqui, ao lado da do Olist, porque ambas são "conexões externas do
// tenant"; o que ela ALIMENTA (regra de taxa do gateway, listagem por SKU)
// vive nos módulos que já sabem lidar com cada tipo de dado — ver
// NuvemshopFeeRuleProvider (marketplace-intelligence) e ChannelListing
// (channel_integration) logo abaixo.
//
// Autenticação: "app privado" da Nuvemshop — storeId + access_token gerado
// direto no painel (Configurações > Meus Aplicativos > Criar app privado),
// mesma categoria de decisão do token estático do Olist V2: evita construir
// um fluxo de autorização OAuth2 (que a Nuvemshop também oferece, para apps
// públicos) sem poder validar os endpoints exatos ao vivo neste ambiente.
model NuvemshopConnection {
  tenantId       String    @id
  storeId        String
  accessTokenEnc String // criptografado em repouso (CredentialEncryptionService)
  isActive       Boolean   @default(true)
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("nuvemshop_connections")
  @@schema("erp_integration")
}

// ============================================================================
// Channel Integration — vínculo SKU x anúncio/produto em cada canal de venda.
// Era o "próximo módulo natural" que eu tinha deixado explicitamente fora de
// escopo na primeira versão do ERP Integration; entrou agora porque a
// Nuvemshop trouxe a necessidade real. Uma linha = um produto do ERP
// vinculado a UM listing em UM canal — o mesmo SKU pode (vai) ter várias
// linhas (uma por canal: Nuvemshop, Mercado Livre, Shopee...).
// ============================================================================

model ChannelListing {
  id         String   @id @default(uuid())
  tenantId   String
  skuCode    String // chave de vínculo — o mesmo SKU que já é único em Product (schema catalog)
  channelCode String // "NUVEMSHOP" | "MERCADO_LIVRE" | "SHOPEE" — string, não enum, mesmo racional do Marketplace: canal novo é dado, não migration
  externalId String // id do produto/variante no canal

  currentPrice Decimal? @db.Decimal(12, 2) // preço de venda hoje naquele canal — informativo, espelhado
  url          String?

  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, channelCode, externalId])
  @@index([tenantId, skuCode])
  @@map("channel_listings")
  @@schema("channel_integration")
}

// ============================================================================
// Competition Intelligence — radar de concorrência (docs/competition-intelligence-architecture.md).
//
// Três tabelas, cada uma com um papel:
// 1. MonitoredCompetitorListing — CONFIGURAÇÃO: qual SKU nosso deve ser
//    comparado com qual oferta de concorrente, e por qual radar. Não é
//    histórico nem read-model, é o "o que monitorar".
// 2. CompetitorOfferSnapshot — HISTÓRICO, append-only. Uma linha por
//    coleta do radar. É a tabela que o Analytics vai consumir (série
//    temporal de preço de concorrente) — nunca é lida pelo Pricing Engine
//    no caminho de precificação, só por relatório/BI. Cresce sem limite;
//    índice por (tenantId, skuCode, collectedAt) é o que sustenta isso.
// 3. CompetitiveOpportunity — READ-MODEL enxuto, uma linha por (tenant, SKU),
//    sempre a ÚLTIMA leitura processada (upsert, igual ErpSyncChangeEvent).
//    É a ÚNICA tabela deste módulo que o Pricing Engine consulta — O(1) por
//    SKU, nunca um scan de histórico. Atualizada pelo orquestrador sempre
//    que um novo snapshot é processado.
// ============================================================================

enum CompetitionRadarSourceType {
  SCRAPING // coleta direta de página pública do concorrente
  PARTNER_API // ex.: PriceAPI ou serviço equivalente de terceiro
  INTERNAL_MONITORING // dado que o próprio time alimenta manualmente/via planilha

  @@schema("competition_intelligence")
}

enum BuyBoxStatus {
  WINNING
  LOSING
  UNKNOWN // ainda não há oferta comparável suficiente pra decidir

  @@schema("competition_intelligence")
}

model MonitoredCompetitorListing {
  id             String   @id @default(uuid())
  tenantId       String
  skuCode        String // vínculo por SKU — mesmo padrão do ChannelListing
  competitorLabel String // nome/identificação do concorrente, livre (ex.: "Loja X no ML")
  targetRef      String // URL ou id que o radar usa pra saber o que buscar
  radarCode      String // código do CompetitionRadar responsável (ver contrato em shared/contracts)
  // Opcional: qual dos NOSSOS canais (ChannelListing.channelCode) usar como
  // "nosso preço" na comparação. Nulo = monitoramos o concorrente mas ainda
  // não sabemos comparar com um preço nosso (buyBoxStatus fica UNKNOWN) —
  // mesma disciplina de "não inventar dado" já usada no restante do projeto.
  channelCode    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, skuCode, targetRef])
  @@index([tenantId, isActive])
  @@map("monitored_competitor_listings")
  @@schema("competition_intelligence")
}

model CompetitorOfferSnapshot {
  id              String                     @id @default(uuid())
  tenantId        String
  skuCode         String
  competitorLabel String
  price           Decimal                    @db.Decimal(12, 2)
  isBuyBoxWinner  Boolean?
  sourceRadarCode String
  sourceEvidenceRef String? // URL/id da coleta específica, pra auditoria
  collectedAt     DateTime

  // Histórico puro — nunca atualizado, só inserido. Índice pensado pra
  // Analytics (série temporal por SKU), não pra lookup pontual.
  @@index([tenantId, skuCode, collectedAt])
  @@map("competitor_offer_snapshots")
  @@schema("competition_intelligence")
}

model CompetitiveOpportunity {
  tenantId            String
  skuCode             String
  bestCompetitorPrice Decimal      @db.Decimal(12, 2)
  bestCompetitorLabel String
  ourPrice            Decimal?     @db.Decimal(12, 2) // nulo se ainda não vinculado a um preço nosso
  // Canal usado para resolver ourPrice (MonitoredCompetitorListing.channelCode
  // no momento desta leitura) — nulo pela mesma razão que ourPrice pode ser
  // nulo. Existe para que o Pricing Intelligence saiba EM QUAL CANAL aplicar
  // uma decisão de preço (PRICE_UPDATE_DISPATCHER exige marketplaceCode +
  // externalId, não só o SKU) — ver pricing-intelligence-architecture.md, seção 7.
  channelCode         String?
  priceGapPct         Float // (ourPrice - bestCompetitorPrice) / bestCompetitorPrice — negativo = estamos mais baratos
  buyBoxStatus        BuyBoxStatus @default(UNKNOWN)
  rank                Int? // nossa posição entre as ofertas conhecidas, quando calculável
  detectedAt          DateTime // quando esta leitura foi processada (não a hora da coleta bruta)
  updatedAt           DateTime     @updatedAt

  @@id([tenantId, skuCode])
  @@map("competitive_opportunities")
  @@schema("competition_intelligence")
}

// ============================================================================
// Financial Intelligence — DRE (Demonstrativo de Resultado) + Contas a
// Receber. Ver docs/financial-intelligence-architecture.md.
//
// Duas tabelas, dois papéis bem distintos (mesma disciplina do resto da
// plataforma: não misturar "configuração" com "histórico transacional"):
// 1. FixedExpense — CONFIGURAÇÃO: as despesas fixas recorrentes do tenant
//    (aluguel, folha, softwares...). Uma linha por despesa cadastrada, não
//    por ocorrência mensal — a recorrência é um CAMPO (recurrenceType +
//    dueDay), não uma linha nova a cada mês. Projeção de fluxo de caixa
//    futura "expande" isso em ocorrências na hora de montar a projeção,
//    não armazena as ocorrências.
// 2. ReceivableRecord — TRANSACIONAL: uma linha por repasse esperado de um
//    marketplace (o "A Receber"). Fica PENDING até a reconciliação (ver
//    ReceivableReconciliationService) casar um repasse importado com esta
//    linha e marcar PAID — nunca side-by-side com FixedExpense porque tem
//    ciclo de vida e cardinalidade completamente diferentes.
// ============================================================================

enum FixedExpenseRecurrence {
  MONTHLY
  WEEKLY
  YEARLY
  ONE_TIME // despesa pontual (ex.: reforma) — projeção de fluxo de caixa a considera uma única vez, na dueDay/mês de cadastro

  @@schema("financial_intelligence")
}

model FixedExpense {
  id             String                 @id @default(uuid())
  tenantId       String
  name           String // ex.: "Aluguel do galpão", "Folha de pagamento"
  amount         Decimal                @db.Decimal(12, 2)
  recurrenceType FixedExpenseRecurrence
  // Dia do mês (1-31) ou da semana (0-6), dependendo de recurrenceType —
  // usado só pela futura projeção de fluxo de caixa para posicionar a
  // despesa no calendário; null quando recurrenceType = ONE_TIME (a data já
  // está implícita em createdAt/numa data própria, se vier a existir).
  dueDay         Int?
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([tenantId])
  @@map("fixed_expenses")
  @@schema("financial_intelligence")
}

enum ReceivableStatus {
  PENDING // ainda não reconciliado com nenhum repasse importado
  PAID // reconciliado — ver ReceivableReconciliationService
  OVERDUE // passou de expectedDate sem reconciliar (calculado/atualizado por job, não pela reconciliação em si)
  CANCELLED // pedido cancelado/estornado no marketplace — nunca vai virar PAID

  @@schema("financial_intelligence")
}

model ReceivableRecord {
  id       String  @id @default(uuid())
  tenantId String
  amount   Decimal @db.Decimal(12, 2)
  status   ReceivableStatus @default(PENDING)

  expectedDate DateTime // quando o repasse é esperado (D+X do marketplace, informado na criação)
  paidAt       DateTime? // preenchido só quando a reconciliação casa um repasse importado

  // "marketplace_source" do pedido — string, não enum, mesmo racional de
  // Marketplace.code/ChannelListing.channelCode: canal novo é dado, nunca migration.
  marketplaceSource String

  // Chave de reconciliação: o identificador do pedido/repasse NO
  // marketplace (ex.: order id do Mercado Livre, settlement id da Shopee).
  // Nulo é válido (registro criado manualmente, sem origem de sync ainda)
  // — ver ReceivableReconciliationService para como isso é usado no match.
  externalReference String?

  // Referência SOLTA (não FK) ao SKU de origem, só para permitir side do
  // DRE "por produto" no futuro — mesmo padrão de ChannelListing.skuCode/
  // CompetitiveOpportunity.skuCode: histórico financeiro não pode ficar
  // acoplado ao ciclo de vida do Product.
  skuCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Usado pela consulta "meu A Receber" (lista por status, ordenada por
  // data esperada) — o caminho de leitura mais comum do módulo.
  @@index([tenantId, status, expectedDate])
  // Usado pela reconciliação — encontrar o registro certo a partir do que
  // veio no arquivo de repasse importado.
  @@index([tenantId, marketplaceSource, externalReference])
  @@map("receivable_records")
  @@schema("financial_intelligence")
}

// ============================================================================
// AccountsPayable — Contas a Pagar (Fase 1 do roadmap, benchmark Tiny ERP
// 28/07/2026, docs/tiny-erp-benchmark-analysis.md, seção 1.4). Espelho do
// lado "a pagar" de ReceivableRecord: FixedExpense é config recorrente
// estática (aluguel, folha), ReceivableRecord é repasse de marketplace —
// nenhum dos dois modela "devo X para o fornecedor Y, vence dia Z, dei baixa
// dia W". Fica no mesmo schema financial_intelligence (não um schema novo)
// porque é um registro financeiro como ReceivableRecord, não específico de
// compra — Ordem de Compra (Fase 1, próxima etapa) vai CRIAR linhas aqui via
// evento/porta, mesmo padrão de Orders -> ReceivableFromOrderListener, mas
// uma conta a pagar avulsa (aluguel de terceiro, imposto, frete) não precisa
// nunca ter passado por uma Ordem de Compra.
// ============================================================================

enum AccountsPayableOccurrence {
  UNICA
  SEMANAL
  MENSAL
  TRIMESTRAL
  // Gera N registros de uma vez (ver domain/accounts-payable.entity.ts,
  // buildInstallments) — cada parcela é uma linha própria, ligada pelo
  // installmentGroupId. É a ÚNICA ocorrência que efetivamente cria múltiplos
  // registros hoje: SEMANAL/MENSAL/TRIMESTRAL só rotulam a intenção de
  // recorrência da conta atual (MVP) — gerar a próxima ocorrência automática
  // fica para uma iteração futura (mesmo limite documentado em
  // FixedExpense.dueDay, que também não projeta linhas futuras sozinho).
  PARCELADA

  @@schema("financial_intelligence")
}

enum AccountsPayableStatus {
  PENDING
  PAID
  // Sem CANCELLED aqui virar PAID depois — mesma regra de ReceivableRecord.
  CANCELLED

  @@schema("financial_intelligence")
}

model AccountsPayable {
  id       String                 @id @default(uuid())
  tenantId String
  amount   Decimal                @db.Decimal(12, 2)
  status   AccountsPayableStatus  @default(PENDING)

  description String // ex.: "Aluguel do galpão - Julho/2026", "NF 1234 - Fornecedor X"
  // Plano de contas — texto livre no MVP, mesmo racional de
  // Supplier.paymentTerms: estruturar como taxonomia própria é decisão
  // futura, não bloqueia o valor de ter fornecedor+vencimento+baixa hoje.
  category    String?

  // Referência SOLTA (não FK) para catalog.Supplier — mesmo padrão de
  // ReceivableRecord.skuCode/TagAssignment.entityId: um registro financeiro
  // não pode ficar acoplado ao ciclo de vida do cadastro de fornecedor
  // (schema diferente: catalog vs financial_intelligence). Nullable — nem
  // toda conta a pagar tem um fornecedor cadastrado (ex.: imposto a
  // recolher).
  supplierId String?

  dueDate DateTime
  paidAt  DateTime? // preenchido só por AccountsPayableService.markPaid — nunca por update()

  // Quick Win 4 (benchmark Bling, 29/07/2026, docs/bling-erp-benchmark-analysis.md,
  // seção 2 — ContasBaixarContaDTO: juros/desconto/acrescimo/valorRecebido/tarifa)
  // — todos null até a baixa. paidAmount é o valor de fato baixado (pode
  // diferir de `amount`); os três seguintes são o detalhamento do ajuste.
  // Ver domain/accounts-payable.entity.ts (resolvePaidAmount).
  paidAmount      Decimal? @db.Decimal(12, 2)
  interestAmount  Decimal? @db.Decimal(12, 2) // juros
  discountAmount  Decimal? @db.Decimal(12, 2) // desconto
  feeAmount       Decimal? @db.Decimal(12, 2) // tarifa

  occurrence AccountsPayableOccurrence @default(UNICA)

  // Preenchidos só quando occurrence = PARCELADA (ver buildInstallments) —
  // installmentGroupId liga as N parcelas da mesma compra/dívida original;
  // installmentNumber/totalInstallments são "3 de 12", etc. Todos null para
  // as demais ocorrências (cada uma é uma linha independente).
  installmentGroupId String?
  installmentNumber  Int?
  totalInstallments  Int?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Consulta "minhas contas a pagar" (lista por status, ordenada por
  // vencimento) — caminho de leitura mais comum do módulo, mesmo padrão do
  // índice equivalente em ReceivableRecord.
  @@index([tenantId, status, dueDate])
  @@index([tenantId, installmentGroupId])
  @@map("accounts_payable")
  @@schema("financial_intelligence")
}

// ============================================================================
// Orders — hub de pedidos multicanal. Ver docs/orders-architecture.md.
//
// Status UNIFICADO, não o status bruto do canal — 6 estágios canônicos,
// inspirados no fluxo de "worklist" do Olist (referência explícita do
// pedido): cada canal (Nuvemshop, Mercado Livre, Shopee...) tem seu próprio
// vocabulário de status, e a tradução para estes 6 estágios acontece DENTRO
// do adapter de cada canal (ex.: NuvemshopOrderProvider.mapStatus), nunca no
// orquestrador genérico — o mesmo princípio de Interface Segregation já
// aplicado a MarketplaceProvider (seção 16 de
// docs/marketplace-intelligence-architecture.md).
// ============================================================================

enum OrderStatus {
  EM_ABERTO // pedido colocado — pagamento pendente, recém-aprovado, ou aguardando processamento inicial
  // Benchmark Tiny ERP (28/07/2026, docs/tiny-erp-benchmark-analysis.md,
  // seção 2.2) — pagamento confirmado, mas a preparação/separação ainda não
  // começou de verdade. Sem este estágio, esse sinal ficava "arredondado"
  // para PREPARANDO_ENVIO (ver mapMercadoLivreStatus) — otimista demais para
  // o fast path do sync do Mercado Livre, que nunca confirma o envio inline.
  APROVADO
  PREPARANDO_ENVIO // separação/embalagem em andamento — gatilho operacional (ver ORDER_EVENTS.READY_FOR_FULFILLMENT)
  FATURADO // nota fiscal emitida (hoje só um estágio manual/futuro — ver honestidade técnica na doc)
  ENVIADO // postado/despachado, com código de rastreio
  ENTREGUE // confirmado como entregue pelo canal ou pela transportadora
  // Benchmark Tiny ERP (28/07/2026, seção 2.2) — entrega tentada pela
  // transportadora e FALHOU (sinal real de shipping.status = not_delivered
  // no Mercado Livre). Antes deste estágio, esse sinal ficava preso em
  // ENVIADO, mascarando um problema logístico que merece alerta operacional
  // — ver ORDER_EVENTS.DELIVERY_FAILED. NÃO é terminal (ao contrário de
  // CANCELADO): uma reentrega bem-sucedida ainda pode levar a ENTREGUE.
  NAO_ENTREGUE
  CANCELADO // cancelado ou estornado em qualquer ponto do fluxo — estágio terminal negativo

  @@schema("orders")
}

// Etapa 17 (escalabilidade multicanal) — quem é o responsável legal por
// emitir a nota fiscal deste pedido. Nuvemshop/loja própria: SEMPRE o
// vendedor (SELLER). Alguns marketplaces (Amazon e, em alguns modelos,
// Magalu) faturam EM NOME do vendedor ou até assumem a nota fiscal
// diretamente, dependendo do programa de vendas contratado — isso muda qual
// sistema deve gerar a NF-e e não pode ser assumido como constante entre
// canais. Default SELLER (o caso mais comum/conservador); cada adapter
// declara o valor real quando souber.
enum FiscalResponsibility {
  SELLER
  MARKETPLACE

  @@schema("orders")
}

model Order {
  id       String @id @default(uuid())
  tenantId String

  // Canal de origem — string, não enum, mesmo racional de Marketplace.code/
  // ChannelListing.channelCode: canal novo é dado, nunca migration.
  channelCode     String
  externalOrderId String // id do pedido NO CANAL — metade da chave de idempotência

  status         OrderStatus @default(EM_ABERTO) // unificado — o que a UI (worklist) e o resto do sistema leem
  externalStatus String // status BRUTO do canal, preservado para auditoria/depuração do mapeamento

  subtotalAmount Decimal @db.Decimal(12, 2) // soma dos itens, antes de frete/desconto
  shippingAmount Decimal @db.Decimal(12, 2) @default(0)
  discountAmount Decimal @db.Decimal(12, 2) @default(0)
  totalAmount    Decimal @db.Decimal(12, 2) // o que o cliente pagou de fato

  currency String @default("BRL")

  // --- Normalização financeira (Etapa 17, escalabilidade multicanal) ---
  // Preenchidos PELO ADAPTER de cada canal — nunca calculados aqui ou em
  // qualquer serviço de aplicação — exatamente para que ReceivableFromOrderListener
  // e o resto do Financial Intelligence leiam um valor já pronto, sem if/else
  // por canal. Ver docs/orders-architecture.md, seção 11.
  //
  // feeAmount: comissão do marketplace deduzida deste pedido. Zero é um
  // valor válido e honesto — ex.: Nuvemshop é a loja própria do vendedor,
  // não tem comissão de marketplace sobre o pedido (a única dedução real ali
  // é a taxa do gateway de pagamento, tratada por um mecanismo agregado
  // separado — NuvemshopFeeRuleProvider — não por pedido).
  // netAmount: totalAmount - feeAmount - qualquer outra dedução que o canal
  // exponha (ex.: frete descontado do repasse). É este campo, não
  // totalAmount, que popula ReceivableRecord.amount.
  feeAmount Decimal @db.Decimal(12, 2) @default(0)
  // @default(0) só por segurança de migration (linhas pré-existentes de uma
  // eventual instalação já rodando) — na prática, OrderSyncOrchestrator
  // SEMPRE calcula e grava o valor real antes de persistir; nunca depende
  // deste default em operação normal.
  netAmount Decimal @db.Decimal(12, 2) @default(0)

  // --- Campos fiscais (Etapa 17) — aditivos, todos opcionais: nenhum canal
  // hoje (Nuvemshop) preenche isso, mas Amazon/Magalu podem exigir. Ver
  // docs/orders-architecture.md, seção 12.
  fiscalResponsibility FiscalResponsibility @default(SELLER)
  buyerTaxId           String? // CPF/CNPJ do comprador — exigido para emissão de NF-e em qualquer responsabilidade fiscal
  invoiceNumber        String? // nº da NF-e ou chave de acesso, quando o canal ou uma integração fiscal já emitiu

  // "Data limite de despacho" (prazo de handling) — comum em ML/Shopee,
  // usado pela worklist para priorizar pedidos perto de vencer o prazo.
  // Nulo quando o canal não informa isso (ex.: Nuvemshop não tem esse conceito nativo).
  shippingDeadlineAt DateTime?

  orderedAt   DateTime // data do pedido no canal — não a data de ingestão (ver syncedAt)
  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  // Bug de produção (25/07/2026) — ver README, "Reestruturação do sync ML":
  // null = nunca tivemos uma confirmação REAL do status de envio via
  // GET /shipments/{id} pra este pedido (só o status bruto de /orders/search,
  // que não traz envio). Usado por MercadoLivreShipmentEnrichmentJob (novo)
  // pra achar, de forma resumível e sem estado em memória, os pedidos que
  // ainda faltam enriquecer — sobrevive a qualquer reinício/interrupção do
  // processo, ao contrário de um cursor guardado só em memória. Nunca setado
  // pelo caminho rápido de ingestão inicial (que deliberadamente pula a
  // consulta de envio pra não travar o backfill); setado sempre que QUALQUER
  // caminho (sync normal ou a varredura dedicada) recebe uma resposta real
  // do sub-recurso de envio.
  shippingStatusCheckedAt DateTime?

  // Payload cru do canal, para auditoria/depuração — nunca lido pelo resto
  // do sistema, só existe para investigar um mapeamento que deu errado sem
  // precisar re-chamar a API externa.
  rawPayload Json?

  syncedAt  DateTime @default(now()) // última vez que este pedido foi escrito pelo sync (distinto de orderedAt)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Modo de Demonstração / Audit Mode — pedido fictício injetado por
  // AuditSeederService (nunca por um OrderSyncOrchestrator real; nenhum
  // adapter de canal jamais escreve isso). @default(false) é o que garante
  // a segregação "automática" pedida: toda query existente que já rodava
  // antes desta migração (worklist, DRE, contadores) continua só vendo
  // isDemo = false sem precisar ser tocada — o filtro por dataMode
  // ('REAL' | 'DEMO') vive na camada de repositório
  // (PrismaOrderRepository), nunca deixado a cargo de quem chama. Ver
  // docs/audit-mode.md.
  isDemo Boolean @default(false)

  items OrderItem[]

  // Sprint 24 — vínculo com o Hub de Provas (logistics_fulfillment): um
  // pedido de varejo aparece em exatamente um StockMovementAuditEvent
  // (RETAIL_SHIPMENT); um pedido embarcado num lote Full aparece no evento
  // daquele lote (FULL_DISPATCH), junto de outros pedidos do mesmo despacho.
  stockMovementLinks StockMovementAuditEventOrder[]

  // Fase 5 (Expedição em lote) — um pedido pode ter passado por N tentativas
  // de lote (ex.: removido de um lote cancelado e incluído num novo depois),
  // por isso é uma relação 1:N, não 1:1.
  dispatchBatchLinks DispatchBatchOrder[]

  // Idempotência: a MESMA chave de negócio (canal + id externo) nunca gera
  // duas linhas — todo upsert do OrderSyncOrchestrator usa este índice.
  @@unique([tenantId, channelCode, externalOrderId])
  // Consulta mais comum: a worklist filtrando por status (abas) + ordenando por data.
  @@index([tenantId, status, orderedAt])
  @@index([tenantId, channelCode, orderedAt])
  // Filtro por dataMode (REAL exclui isDemo, DEMO só isDemo) em toda query —
  // worklist, contadores e DRE.
  @@index([tenantId, isDemo])
  // Consulta da varredura dedicada de enriquecimento de envio
  // (MercadoLivreShipmentEnrichmentJob) — "pedidos PREPARANDO_ENVIO deste
  // canal, nunca checados, dos mais recentes pra trás, limitado a N por vez".
  @@index([tenantId, channelCode, status, shippingStatusCheckedAt, orderedAt])
  @@map("orders")
  @@schema("orders")
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Referência SOLTA (não FK) ao produto interno — resolvida no momento da
  // ingestão via PRODUCT_CATALOG_READER.findBySku(tenantId, externalSku); pode
  // ficar nula se o SKU do canal ainda não tiver um Product correspondente
  // (produto não sincronizado/cadastrado ainda) — mesmo padrão de
  // ChannelListing.skuCode/CompetitiveOpportunity.skuCode.
  skuCode String?

  // O identificador cru do item NO CANAL (sku da variante, ou id do produto
  // quando o canal não expõe SKU) — sempre presente, independente de ter
  // sido possível resolver para um skuCode interno.
  externalSku String
  productName String // snapshot do nome no momento do pedido — não segue mudanças futuras do produto

  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  totalPrice Decimal @db.Decimal(12, 2)

  // Imposto discriminado por item (Etapa 17) — regras fiscais brasileiras
  // (NF-e) exigem o tributo por item, não só um total no pedido. Opcional:
  // nulo quando o canal não expõe essa quebra (caso da Nuvemshop hoje).
  taxAmount Decimal? @db.Decimal(12, 2)

  // Vendedores + Comissão (Projeto Estruturante 3, benchmark Bling ERP,
  // 29/07/2026, docs/sellers-architecture.md) — referência SOLTA (não
  // FK/relation Prisma) ao Vendedor (schema sellers), mesmo racional de
  // skuCode -> Product: atribuição manual explícita
  // (CommissionService.assignVendedor), nunca inferida automaticamente do
  // canal/pedido. comissaoAliquotaPct/comissaoValor são SNAPSHOT calculado
  // no momento da atribuição — mudar Vendedor.aliquotaComissaoPct depois
  // NUNCA recalcula itens já atribuídos (mesmo racional de costPrice acima).
  vendedorId          String?
  comissaoAliquotaPct Decimal? @db.Decimal(5, 2)
  comissaoValor       Decimal? @db.Decimal(12, 2)
  // Null = comissão ainda não incluída em nenhuma geração de conta a pagar
  // (CommissionService.generatePayout) — setado em bloco no momento da
  // geração, nunca antes, para impedir pagar a MESMA comissão duas vezes.
  comissaoPagaEm      DateTime?

  // Custo de aquisição no momento do pedido (Etapa 19, Orquestração de
  // Custos) — SNAPSHOT do custo efetivo (Product.costPrice + Packaging.costPrice,
  // ver ProductCatalogReader) capturado pelo OrderSyncOrchestrator quando o
  // SKU do item é resolvido contra o catálogo interno (mesmo momento em que
  // `skuCode` é preenchido). NUNCA vem do canal/marketplace — custo é dado
  // NOSSO, não do RawOrderItemCandidate.
  //
  // Nullable de propósito: (a) pedidos sincronizados ANTES desta etapa nunca
  // tiveram esse campo — migrar retroativamente inventaria um custo que
  // ninguém registrou de fato; (b) itens cujo SKU não resolve contra o
  // catálogo (produto não cadastrado ainda) também ficam sem valor aqui, o
  // mesmo padrão de `skuCode` nulo. O fallback para os dois casos vive no
  // OrdersService (ver domain/order-margin.ts) — nunca inventa retroativamente
  // o custo daquele momento, usa o custo ATUAL do produto como a melhor
  // aproximação disponível, e sinaliza isso explicitamente
  // (`costSource: 'CURRENT_PRODUCT'`) para quem lê a margem.
  costPrice Decimal? @db.Decimal(12, 2)

  @@index([orderId])
  // Vendedores + Comissão — consulta central de CommissionService
  // (listCommissions/generatePayout): "itens deste vendedor ainda não
  // pagos" — mesmo racional de índices compostos existentes (ex.:
  // logistics_fulfillment shipping enrichment).
  @@index([vendedorId, comissaoPagaEm])
  @@map("order_items")
  @@schema("orders")
}

// ============================================================================
// Logistics Fulfillment — Hub de Provas + Full Fulfillment (Sprint 24).
// Ver docs/logistics-fulfillment-architecture.md.
//
// Regra de ouro estrutural: StockLedgerEntry (o único lugar que de fato
// move estoque) tem auditEventId NOT NULL — não existe caminho de aplicação
// que grave uma linha de ledger sem referenciar um StockMovementAuditEvent,
// e o único método de serviço que cria StockLedgerEntry
// (StockMovementAuditEventService.approve) recusa fazer isso se
// conferenceStatus não estiver APROVADO ou mediaUrl estiver vazio. Ver
// domain/stock-movement-audit-event.ts (canApprove) para a validação pura.
// ============================================================================

enum WarehouseType {
  PHYSICAL // o galpão/estoque próprio do vendedor — sempre um por tenant
  VIRTUAL_FULL // um depósito virtual por CD de marketplace (ex.: CD_FULL_ML)

  @@schema("logistics_fulfillment")
}

model Warehouse {
  id       String        @id @default(uuid())
  tenantId String
  code     String // "FISICO_SP", "CD_FULL_ML", "CD_FULL_SHOPEE"
  type     WarehouseType
  // Preenchido só quando type = VIRTUAL_FULL — qual canal esse CD
  // representa. String, não enum, mesmo racional de Marketplace.code:
  // canal novo é dado, nunca migration.
  channelCode String?
  isActive    Boolean  @default(true)
  // Lead time de reabastecimento (Sprint 25) — dias entre despachar do
  // físico e o estoque ficar disponível para venda NESTE depósito.
  // Configurável por depósito (em vez de constante no código) porque a
  // performance logística varia por canal/CD — editável via
  // PATCH /logistics-fulfillment/warehouses/:id/lead-time. Default 15,
  // confirmado com o usuário como ponto de partida; o motor de sugestão
  // (ReplenishmentAdvisorService) lê SEMPRE este campo, nunca um valor fixo.
  leadTimeDays Int @default(15)
  // Custo operacional deste depósito (picking/armazenagem no Full, manuseio
  // no Físico) — Sprint 26 (Motor de Margem de Promoções). Deliberadamente
  // NÃO inclui custo de embalagem: esse vem do módulo de embalagens
  // (Packaging.costPrice), via LogisticsCostReader, para nunca contar o
  // mesmo custo duas vezes. Default 0 — ninguém preencheu ainda; enquanto
  // isso, o motor de margem simplesmente não soma custo operacional nenhum
  // (nunca assume um valor arbitrário). Editável via PATCH
  // /logistics-fulfillment/warehouses/:id/logistics-cost.
  logisticsCostPerUnit Decimal @default(0) @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Única relação entre Warehouse e StockLedgerEntry — não precisa de nome.
  ledgerEntries StockLedgerEntry[]
  // Warehouse tem DUAS relações distintas com StockMovementAuditEvent
  // (origem e destino) — cada uma precisa de um nome explícito para o
  // Prisma saber qual FK corresponde a qual back-relation.
  destinationForEvents StockMovementAuditEvent[] @relation("DestinationWarehouse")
  sourceForEvents      StockMovementAuditEvent[] @relation("SourceWarehouse")
  // Benchmark Tiny ERP (28/07/2026) — localização física do SKU dentro
  // deste depósito, ver ProductWarehouseLocation abaixo.
  productLocations ProductWarehouseLocation[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
  @@map("warehouses")
  @@schema("logistics_fulfillment")
}

enum StockMovementEventType {
  FULL_DISPATCH // lote de despacho para um CD do Full — pode embarcar N pedidos, ou nenhum (reabastecimento preventivo)
  RETAIL_SHIPMENT // envio de um único pedido de varejo direto ao comprador final
  // Ordem de Compra (Fase 1, 28/07/2026) — ÚNICO tipo de ENTRADA (crédito),
  // os outros dois são saída (débito). "Prova" aqui é o número da NF do
  // fornecedor (invoiceNumber), não mídia/vídeo — risco de fraude é
  // diferente de mercadoria SAINDO do depósito. Ver
  // domain/stock-movement-audit-event.entity.ts, canApprovePurchaseReceipt/
  // buildPurchaseReceiptLedgerEntries.
  PURCHASE_RECEIPT
  // Ordem de Produção (Projeto Estruturante 1, benchmark Bling, 29/07/2026)
  // — conclusão de uma ProductionOrder (schema production): debita os
  // componentes consumidos (uma ou mais linhas negativas) E credita o
  // produto acabado (uma linha positiva), tudo no MESMO auditEventId. Prova
  // de autorização é a própria ProductionOrder já confirmada pelo usuário
  // (ação explícita "concluir ordem"), não mídia nem NF — ver
  // canApproveProduction/buildProductionLedgerEntries.
  PRODUCTION_OUTPUT
  // Lançamento manual por lote (Projeto Estruturante 2, benchmark Bling,
  // 29/07/2026) — Entrada/Saída/Balanço avulso vinculado a um ProductLot
  // específico (catalog.product_lots), ex.: correção de contagem física,
  // baixa de vencido, entrada de um lote recém-recebido fora do fluxo de
  // Ordem de Compra. Prova de autorização é a justificativa textual
  // informada (campo `notes`, abaixo) — não existe mídia nem NF aplicável a
  // um ajuste 100% interno. Ver
  // canApproveLotAdjustment/buildLotAdjustmentLedgerEntry.
  LOT_ADJUSTMENT

  @@schema("logistics_fulfillment")
}

enum ConferenceStatus {
  PENDENTE // criado, aguardando mídia + avaliação humana — NENHUM StockLedgerEntry existe ainda
  APROVADO // conferido e batido com o pedido/NF — só agora o ledger é gravado
  DIVERGENTE // conferido e NÃO bateu — nunca gera ledger, sempre emite alerta técnico (ver AlertService)

  @@schema("logistics_fulfillment")
}

// O "Hub de Provas" propriamente dito — um registro por evento de saída de
// estoque, seja um despacho Full ou um envio de varejo. NUNCA é o
// movimento de estoque em si (isso é StockLedgerEntry) — é o que AUTORIZA
// esse movimento a acontecer.
model StockMovementAuditEvent {
  id       String                  @id @default(uuid())
  tenantId String
  eventType StockMovementEventType

  sourceWarehouseId String // sempre o físico, em ambos os tipos de evento
  sourceWarehouse   Warehouse @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])

  // Nulo em RETAIL_SHIPMENT (venda ao consumidor final não credita depósito
  // nenhum nosso) — preenchido só em FULL_DISPATCH (o CD_FULL_* de destino).
  destinationWarehouseId String?
  destinationWarehouse   Warehouse? @relation("DestinationWarehouse", fields: [destinationWarehouseId], references: [id])

  // Mídia da conferência — nula até alguém de fato anexar. mediaType é
  // "PHOTO" ou "VIDEO"; string (não enum) para não exigir migration se um
  // formato novo (ex.: PDF de checklist assinado) precisar ser aceito.
  mediaUrl  String?
  mediaType String?

  conferenceStatus  ConferenceStatus @default(PENDENTE)
  conferredByUserId String?
  conferredAt       DateTime?
  // Preenchido (na prática, obrigatório na camada de aplicação) quando
  // conferenceStatus = DIVERGENTE — o motivo exato da divergência.
  divergenceNotes String?

  // Vínculo com a Nota Fiscal correspondente — mesmo campo/formato de
  // Order.invoiceNumber (nº da NF-e ou chave de acesso).
  invoiceNumber String?

  // Justificativa textual (Projeto Estruturante 2, benchmark Bling,
  // 29/07/2026) — só usado por LOT_ADJUSTMENT hoje: é a "prova" desse tipo
  // de evento, ver canApproveLotAdjustment. Genérico o bastante para ser
  // reaproveitado por outro tipo de evento futuro que precise do mesmo
  // racional (correção interna sem mídia/NF).
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders StockMovementAuditEventOrder[]
  ledger StockLedgerEntry[]

  // Sprint 27 (Pick & Pack) — checklist de bipagem (1 linha por SKU
  // esperado) e a sessão de captura de vídeo em chunks, ambas 1:N/1:1 deste
  // mesmo evento. Ver docs/pick-pack-architecture.md.
  items              StockMovementAuditEventItem[]
  videoCaptureSession VideoCaptureSession?

  @@index([tenantId, conferenceStatus])
  @@index([tenantId, eventType, createdAt])
  @@map("stock_movement_audit_events")
  @@schema("logistics_fulfillment")
}

// Checklist de bipagem (Sprint 27, "Objetivo Zero Erro") — 1 linha por SKU
// esperado neste evento, montada no momento da criação (createPending) a
// partir dos itens dos pedidos vinculados (via OrderFinancialsReader.
// findItemsForOrders) — snapshot, mesmo racional de OrderItem.costPriceUsed:
// não recalculado depois, mesmo que o pedido mude. scannedQuantity nunca
// ultrapassa expectedQuantity (função pura canScanItem barra isso antes de
// chegar ao repositório). expectedQuantity agregada por SKU (dois itens do
// mesmo SKU em pedidos diferentes do mesmo lote viram uma linha só, soma).
model StockMovementAuditEventItem {
  id       String @id @default(uuid())
  tenantId String

  auditEventId String
  auditEvent   StockMovementAuditEvent @relation(fields: [auditEventId], references: [id], onDelete: Cascade)

  skuCode          String
  expectedQuantity Int
  scannedQuantity  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([auditEventId, skuCode])
  @@index([tenantId, auditEventId])
  @@map("stock_movement_audit_event_items")
  @@schema("logistics_fulfillment")
}

enum VideoCaptureStatus {
  RECORDING
  FINALIZED

  @@schema("logistics_fulfillment")
}

// Sessão de captura de vídeo em chunks (Sprint 27) — 1:1 com o audit event.
// Estratégia escolhida: MediaDevices API no navegador (MediaRecorder com
// timeslice) fazendo upload incremental de cada blob assim que é gerado,
// em vez de RTSP/streaming para servidor de mídia dedicado — ver
// docs/pick-pack-architecture.md, seção 2, para o racional completo.
// receivedChunkCount é a fonte da verdade de idempotência: um chunk com
// sequence < receivedChunkCount é uma retransmissão (rede instável) e é
// descartado sem reescrever o arquivo; sequence > receivedChunkCount é uma
// lacuna (erro de cliente) e é rejeitado. storageKey aponta para o arquivo
// no disco que vai recebendo os chunks via append (nunca reescrito do
// zero) — resiliente a queda de processo no meio da gravação, porque cada
// chunk já commitado no disco não depende do restante da sessão.
model VideoCaptureSession {
  id       String @id @default(uuid())
  tenantId String

  auditEventId String                  @unique
  auditEvent   StockMovementAuditEvent @relation(fields: [auditEventId], references: [id], onDelete: Cascade)

  storageKey         String
  status             VideoCaptureStatus @default(RECORDING)
  receivedChunkCount Int                @default(0)
  totalBytes         Int                @default(0)

  startedAt   DateTime  @default(now())
  finalizedAt DateTime?

  // Retenção de 30 dias (premissa de negócio) — preenchido pelo job de
  // limpeza em background quando o ARQUIVO físico é apagado. O metadado
  // (esta linha) nunca é apagado — é o registro de que a conferência visual
  // aconteceu, mesmo depois que os bytes pesados do vídeo já foram
  // descartados. Ver docs/pick-pack-architecture.md, seção 3.
  videoDeletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([finalizedAt])
  @@map("video_capture_sessions")
  @@schema("logistics_fulfillment")
}

// Join N:N — um envio de varejo vincula exatamente 1 Order; um despacho
// Full pode vincular N Orders (todos os pedidos embarcados naquele lote),
// ou zero (reabastecimento preventivo do CD, não motivado por pedido
// nenhum ainda).
model StockMovementAuditEventOrder {
  auditEventId String
  auditEvent   StockMovementAuditEvent @relation(fields: [auditEventId], references: [id], onDelete: Cascade)
  orderId      String
  order        Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@id([auditEventId, orderId])
  @@index([orderId])
  @@map("stock_movement_audit_event_orders")
  @@schema("logistics_fulfillment")
}

// Ledger append-only — a ÚNICA fonte da verdade do saldo de estoque por
// (warehouse, sku). Nunca é UPDATE, sempre INSERT; saldo = soma de
// quantityDelta. auditEventId é NOT NULL de propósito: é isso que torna a
// regra de ouro estrutural (ver comentário no topo desta seção), não uma
// convenção que depende de disciplina de quem programa depois.
model StockLedgerEntry {
  id       String @id @default(uuid())
  tenantId String

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  skuCode     String

  // Negativo = saída (débito), positivo = entrada (crédito). Uma
  // transferência Full grava DUAS linhas com o mesmo auditEventId: uma
  // negativa no físico, uma positiva no CD virtual de destino.
  quantityDelta Int

  auditEventId String
  auditEvent   StockMovementAuditEvent @relation(fields: [auditEventId], references: [id])

  // Produtos-Lotes (Projeto Estruturante 2, benchmark Bling, 29/07/2026) —
  // dimensão ADITIVA do mesmo ledger, nunca uma tabela de saldo separada
  // (mesmo racional estrutural do resto deste model). null = SKU sem
  // controle de lote (Product.controlaLote = false), o caso de longe mais
  // comum hoje — todo o histórico existente antes desta migração tem
  // lotCode null e continua funcionando exatamente igual. Preenchido só
  // pelos lançamentos LOT_ADJUSTMENT (ver
  // buildLotAdjustmentLedgerEntry) — os outros tipos de evento
  // (RETAIL_SHIPMENT, FULL_DISPATCH, PURCHASE_RECEIPT, PRODUCTION_OUTPUT)
  // ainda não escrevem lotCode; ver docs/product-lots-architecture.md,
  // seção 5, para o gap documentado (consumo automático de lote nesses
  // fluxos é extensão futura).
  lotCode String?

  createdAt DateTime @default(now())

  // Consulta mais comum: saldo atual de um SKU num depósito (soma de
  // quantityDelta filtrando por estes três campos).
  @@index([tenantId, warehouseId, skuCode])
  @@index([auditEventId])
  // Saldo por lote — soma de quantityDelta filtrando também por lotCode.
  @@index([tenantId, warehouseId, skuCode, lotCode])
  @@map("stock_ledger_entries")
  @@schema("logistics_fulfillment")
}

// ============================================================================
// Expedição em lote (Fase 5, benchmark Tiny ERP, 29/07/2026) — ver
// docs/tiny-erp-benchmark-analysis.md, seção 1.2, e
// docs/dispatch-batch-architecture.md.
//
// Extensão direta do Hub de Provas: RETAIL_SHIPMENT já garante a auditoria
// POR PEDIDO (checklist bipado + vídeo, Sprint 27) — DispatchBatch vive numa
// camada ACIMA disso, agrupando N pedidos JÁ CONFERIDOS (StockMovementAuditEvent
// conferenceStatus = APROVADO) numa única operação de etiqueta/despacho, sem
// substituir nem duplicar a conferência por pedido. Mesmo racional do
// screenshot de referência do Olist (usuário, 29/07/2026): um campo único
// "forma de envio" (aqui `formaEnvio`, string livre — mesmo padrão de
// channelCode) mistura etiqueta nativa de marketplace (MERCADO_ENVIOS,
// SHOPEE_ENVIOS), etiqueta via transportadora avulsa (CORREIOS, MELHOR_ENVIO,
// FRENET) e formas puramente organizacionais sem etiqueta real
// (TRANSPORTADORA, RETIRAR_PESSOALMENTE, MOTOBOY, RETIRADO_NO_LOCAL) — a
// aplicação decide QUAL provider (se algum) chamar a partir desse valor, ver
// domain/dispatch-batch.entity.ts (resolveLabelStrategy).
enum DispatchBatchStatus {
  ABERTO // criado, pedidos ainda podendo ser adicionados/removidos
  ETIQUETADO // todo pedido do lote já tem etiqueta gerada (ou a forma de envio não exige etiqueta real)
  DESPACHADO // confirmado como entregue à transportadora/canal — estágio terminal
  CANCELADO

  @@schema("logistics_fulfillment")
}

enum DispatchBatchOrderStatus {
  PENDENTE // no lote, etiqueta ainda não solicitada/gerada
  ETIQUETADO
  ERRO

  @@schema("logistics_fulfillment")
}

model DispatchBatch {
  id       String @id @default(uuid())
  tenantId String

  // String livre — ver comentário acima. Nunca usado para decidir uma regra
  // de negócio via if/else espalhado: resolveLabelStrategy (domínio puro) é
  // o único lugar que traduz este valor para "qual capacidade de provider
  // chamar, se alguma".
  formaEnvio String

  status DispatchBatchStatus @default(ABERTO)

  requestedByUserId String?
  notes             String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  concludedAt DateTime?

  orders DispatchBatchOrder[]

  @@index([tenantId, status])
  @@map("dispatch_batches")
  @@schema("logistics_fulfillment")
}

// Uma linha por PEDIDO dentro de um lote — granularidade própria porque a
// geração de etiqueta pode ter sucesso para uns pedidos do lote e falhar para
// outros (ex.: um pedido sem endereço estruturado suficiente para a
// transportadora avulsa) sem travar o lote inteiro.
model DispatchBatchOrder {
  id       String @id @default(uuid())
  tenantId String

  dispatchBatchId String
  dispatchBatch   DispatchBatch @relation(fields: [dispatchBatchId], references: [id], onDelete: Cascade)

  // Referência real (FK), mesmo padrão já usado dentro deste MESMO schema por
  // StockMovementAuditEventOrder -> Order — DispatchBatchOrder é uma extensão
  // do mesmo bounded context, não um módulo novo desacoplado.
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status DispatchBatchOrderStatus @default(PENDENTE)

  externalLabelId String? // id da etiqueta/documento no provider (quando o provider expõe um)
  trackingCode    String?
  labelUrl        String?
  errorMessage    String?
  labeledAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Um pedido só pode estar em UM lote por vez (gate de elegibilidade,
  // ver domain/dispatch-batch.entity.ts) — mas pode ter passado por lotes
  // ANTERIORES cancelados, por isso não é @@unique([orderId]) sozinho.
  @@unique([dispatchBatchId, orderId])
  @@index([tenantId, orderId])
  @@map("dispatch_batch_orders")
  @@schema("logistics_fulfillment")
}

// ============================================================================
// Etiqueta de envio avulsa (Fase 5) — conexão/credencial por tenant de
// transportadoras que NÃO são um marketplace (Correios, Melhor Envio,
// Frenet). Mesmo padrão de FiscalSettings (token criptografado em repouso via
// CredentialEncryptionService), mas aqui existe UMA linha POR PROVIDER (um
// tenant pode ter Correios E Melhor Envio configurados ao mesmo tempo),
// diferente de FiscalSettings que é singleton (só existe um parceiro fiscal).
// ============================================================================
model FreightProviderConnection {
  id       String @id @default(uuid())
  tenantId String

  providerCode String // "MELHOR_ENVIO" | "CORREIOS" | "FRENET" — ver comentário do schema no topo do arquivo

  // Formato específico de cada provider (token OAuth2, ou token+contrato) —
  // sempre um JSON serializado ANTES de criptografar, nunca campos soltos por
  // provider (evitaria migration a cada transportadora nova).
  credentialEnc String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, providerCode])
  @@map("freight_provider_connections")
  @@schema("freight_shipping")
}

// ============================================================================
// Catálogo de Transportador/Serviço (Projeto Estruturante 5, benchmark Bling
// ERP, 29/07/2026 — ver docs/carrier-catalog-architecture.md). Substitui o
// `DispatchBatch.formaEnvio` texto-livre por um cadastro real — o operador
// escolhe um Carrier+CarrierService cadastrado em vez de digitar um texto que
// precisa bater EXATAMENTE com uma das chaves hardcoded de
// `resolveLabelStrategy` (dispatch-batch.entity.ts). ADITIVO: não muda
// `DispatchBatch.formaEnvio` (continua String) nem nenhum gate de
// dispatch-batch.entity.ts — o cadastro só resolve QUAL string gravar ali
// (via `automationCode`) e permite reconhecer, por alias, um `formaEnvio` já
// existente/legado para exibir nome do transportador + estimativa de entrega.
// ============================================================================
model Carrier {
  id       String @id @default(uuid())
  tenantId String

  name     String
  isActive Boolean @default(true)

  services CarrierService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("carriers")
  @@schema("freight_shipping")
}

model CarrierService {
  id       String @id @default(uuid())
  tenantId String

  carrierId String
  carrier   Carrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  name String // ex.: "SEDEX", "PAC", "Rodoviário Padrão"

  // Nomes alternativos usados para RECONHECER (não gravar) um formaEnvio
  // legado/digitado — normalizados (trim+uppercase) na camada de aplicação,
  // nunca aqui. Ex.: serviço "SEDEX" pode ter aliases ["CORREIOS SEDEX",
  // "CORREIOS_SEDEX"].
  aliases String[] @default([])

  // Informativo — mostrado ao operador, nunca usado por nenhum gate.
  estimativaEntregaDias Int?

  // Preenchido SÓ quando este serviço corresponde a uma automação que o
  // Kyneti já suporta (uma das chaves de LABEL_STRATEGY_BY_FORMA_ENVIO em
  // dispatch-batch.entity.ts, ex.: "CORREIOS", "MELHOR_ENVIO", "FRENET",
  // "MERCADO_ENVIOS", "SHOPEE_ENVIOS"). Nulo = serviço 100% organizacional
  // (motoboy próprio, transportadora regional sem API) — DispatchBatch grava
  // o NOME do serviço como formaEnvio, que resolveLabelStrategy nunca
  // reconhece e cai em NONE (comportamento correto: sem automação).
  automationCode String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([carrierId, name])
  @@index([tenantId, isActive])
  @@map("carrier_services")
  @@schema("freight_shipping")
}

// Benchmark Tiny ERP (28/07/2026, docs/tiny-erp-benchmark-analysis.md, seção
// 1.6) — localização física do SKU dentro de um depósito (corredor/prateleira/bin).
// Deliberadamente SEPARADO de StockLedgerEntry: ledger é um LOG de
// movimentações (append-only, nunca atualizado), localização é um dado
// ATUAL (muda de lugar sem virar "movimento de estoque" — reorganizar uma
// prateleira não é entrada nem saída). skuCode, não productId: mesmo
// racional de StockLedgerEntry, referência solta ao catálogo (o SKU pode
// nem existir mais no Catalog sem quebrar o histórico de localização).
model ProductWarehouseLocation {
  id       String @id @default(uuid())
  tenantId String

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  skuCode     String

  // Texto livre (corredor/prateleira/bin) — mesmo racional de
  // Product.internalCategory: taxonomia própria de cada operação, não uma
  // lista fechada imposta pelo Kyneti.
  location String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Uma localização por SKU por depósito — setar de novo SOBRESCREVE
  // (upsert), nunca acumula histórico (isso é papel do StockLedgerEntry).
  @@unique([tenantId, warehouseId, skuCode])
  @@map("product_warehouse_locations")
  @@schema("logistics_fulfillment")
}

// ============================================================================
// Promotion Intelligence (Sprint 26) — "Motor de Cálculo de Margem": valida
// a viabilidade de uma promoção ANTES de ela existir de verdade. Ver
// docs/promotion-intelligence-architecture.md.
//
// Deliberadamente NÃO criamos uma "ConfiguracaoCanal" — taxa/comissão por
// canal já vem de MarketplaceRule (FEE_RULE_RESOLVER) e política fiscal do
// tenant já vem de CatalogSettings (FINANCIAL_POLICY_READER); duplicar
// qualquer um dos dois aqui criaria duas fontes da verdade divergentes.
// ============================================================================

enum PromotionCampaignStatus {
  DRAFT
  ACTIVE
  ENDED
  CANCELLED

  @@schema("promotion_intelligence")
}

// VERDE = margem líquida positiva, VERMELHO = negativa/prejuízo — "Semáforo
// de Margem" pedido pelo usuário. Nunca um terceiro estado: exatamente 0 é
// tratado como VERMELHO (mesmo racional defensivo do piso financeiro do
// PricingStrategist — na dúvida, bloqueia).
enum MarginStatus {
  VERDE
  VERMELHO

  @@schema("promotion_intelligence")
}

// PENDING nunca é gravado de fato (validateEnrollment sempre resolve para
// APPROVED ou BLOCKED antes do INSERT) — existe só como valor de domínio
// para o tipo TS, não como estado transitório real no banco.
enum EnrollmentStatus {
  PENDING
  APPROVED
  BLOCKED

  @@schema("promotion_intelligence")
}

model PromotionCampaign {
  id          String                  @id @default(uuid())
  tenantId    String
  name        String
  channelCode String
  startAt     DateTime
  endAt       DateTime
  status      PromotionCampaignStatus @default(DRAFT)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  enrollments PromotionEnrollment[]

  @@index([tenantId, channelCode, status])
  @@map("promotion_campaigns")
  @@schema("promotion_intelligence")
}

// Snapshot do cálculo no momento da adesão — mesmo racional de
// OrderItem.costPriceUsed (Etapa 19): nunca recalcula silenciosamente
// depois. Se o custo do produto, a embalagem, a taxa do canal ou a política
// fiscal mudarem depois, este registro continua mostrando o que foi
// avaliado NAQUELE momento; uma reavaliação é uma ação explícita (chamar
// validateEnrollment de novo), nunca implícita.
model PromotionEnrollment {
  id               String    @id @default(uuid())
  tenantId         String
  campaignId       String
  campaign         PromotionCampaign @relation(fields: [campaignId], references: [id])
  skuCode          String
  promotionalPrice Decimal   @db.Decimal(12, 2)

  costPriceUsed   Decimal @db.Decimal(12, 2) // Product.costPrice — SEM embalagem, que está em logisticsCost
  feesAmount      Decimal @db.Decimal(12, 2)
  taxAmount       Decimal @db.Decimal(12, 2)
  logisticsCost   Decimal @db.Decimal(12, 2) // já composto: embalagem (hierarquia) + custo operacional do Warehouse
  netMarginAmount Decimal @db.Decimal(12, 2)
  netMarginPct    Float

  marginStatus     MarginStatus
  enrollmentStatus EnrollmentStatus @default(PENDING)
  blockedReason    String?
  // false quando o FEE_RULE_RESOLVER não encontrou regra cadastrada para o
  // canal (feesAmount assumiu 0) — mesmo alerta que
  // NuvemshopMarginSimulatorService.feeRuleFound já dá hoje, para nunca
  // esconder que a margem calculada pode estar otimista.
  feeRuleFound     Boolean
  computedAt       DateTime @default(now())

  @@unique([campaignId, skuCode])
  @@index([tenantId, marginStatus])
  @@map("promotion_enrollments")
  @@schema("promotion_intelligence")
}

// ============================================================================
// marketplace_ads -> Módulo de Ads multicanal, Fase 1 (dashboard de leitura,
//                     escopo Mercado Livre — ver
//                     docs/marketplace-ads-architecture.md). Granularidade de
//                     CAMPANHA (não ad-group/ad individual) de propósito no
//                     MVP. channelCode é string solta, não FK — mesmo padrão
//                     de ChannelListing/OrderItem, para permitir registrar
//                     Shopee/TikTok/Amazon/Magalu depois sem migration nova.
// ============================================================================

enum AdsCampaignStatus {
  ACTIVE
  PAUSED
  ENDED
  UNKNOWN

  @@schema("marketplace_ads")
}

// Espelha domain/ads-metrics.ts CampaignHealthTier (Fase 2) — duplicado de
// propósito, mesmo padrão de AdsCampaignStatus/BuyBoxStatus: schema.prisma é
// a única fonte de verdade do BANCO, o domínio é a única fonte de verdade da
// REGRA de classificação; a duplicação de nomes é o preço de manter o
// domínio livre de import do Prisma Client.
enum AdsCampaignHealthTier {
  ESTRELA
  PONTO_DE_ATENCAO
  CUSTO_PERDIDO
  SEM_DADOS

  @@schema("marketplace_ads")
}

model AdsCampaign {
  id                  String            @id @default(uuid())
  tenantId            String
  channelCode         String // "MERCADO_LIVRE" hoje — string solta, ver comentário do bloco acima
  externalCampaignId  String // id da campanha no marketplace
  name                String
  status              AdsCampaignStatus @default(UNKNOWN)
  dailyBudget         Decimal?          @db.Decimal(12, 2)
  lastSyncedAt        DateTime          @default(now())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // Fase 2 (alertas inteligentes) — o último tier que gerou um alerta
  // emitido para esta campanha; null quando nunca alertou ou já se
  // recuperou (RESET). Ver domain/ads-metrics.ts, determineAlertAction, e
  // AdsAlertingService (único gravador destes 2 campos).
  lastAlertedTier AdsCampaignHealthTier?
  lastAlertedAt   DateTime?

  // Modo de Demonstração / Audit Mode — mesmo padrão de Order.isDemo:
  // campanha fictícia injetada por AdsAuditSeederService (nunca por um
  // AdsSyncOrchestrator real; nenhum AdsCapableProvider jamais escreve
  // isso). @default(false) garante que toda query existente (dashboard,
  // alertas, fila de sugestões) continua só vendo isDemo = false sem
  // precisar ser tocada — o filtro por dataMode ('REAL' | 'DEMO') vive na
  // camada de repositório (PrismaAdsCampaignRepository/
  // PrismaAdsActionSuggestionRepository), nunca a cargo de quem chama.
  // AdsMetricSnapshot e AdsActionSuggestion (filhos, via campaignId) NÃO
  // carregam o próprio isDemo — são filtrados transitivamente pelo join
  // com a campanha-pai, mesmo racional de OrderItem/Order.
  isDemo Boolean @default(false)

  metrics           AdsMetricSnapshot[]
  // Fase 3 (Safety Lock) — sugestões de ação de escrita geradas a partir do
  // mesmo evento que dispara o alerta (ver AdsActionSuggestion abaixo).
  actionSuggestions AdsActionSuggestion[]

  @@unique([tenantId, channelCode, externalCampaignId])
  @@index([tenantId, channelCode])
  // Filtro por dataMode (REAL exclui isDemo, DEMO só isDemo) — mesmo
  // racional do índice equivalente em Order.
  @@index([tenantId, isDemo])
  @@map("ads_campaigns")
  @@schema("marketplace_ads")
}

// Granularidade DIÁRIA — mesma janela que a maioria das APIs de ads reporta
// (ver AdsCapableProvider.fetchAdsMetrics). tenantId desnormalizado de
// propósito (mesmo padrão de MarketplaceChangeEvent/ErpSyncChangeEvent):
// toda tabela de negócio é filtrada por tenant direto, nunca via join
// implícito.
model AdsMetricSnapshot {
  id          String      @id @default(uuid())
  campaignId  String
  campaign    AdsCampaign @relation(fields: [campaignId], references: [id])
  tenantId    String
  periodDate  DateTime    @db.Date
  spend       Decimal     @db.Decimal(12, 2)
  revenueAds  Decimal     @default(0) @db.Decimal(12, 2)
  clicks      Int         @default(0)
  impressions Int         @default(0)
  syncedAt    DateTime    @default(now())

  @@unique([campaignId, periodDate])
  @@index([tenantId, periodDate])
  @@map("ads_metric_snapshots")
  @@schema("marketplace_ads")
}

// Fase 3 (automação de escrita — Safety Lock, ver
// docs/marketplace-ads-architecture.md, seção 12). Único tipo de ação no
// MVP: pausar a campanha — é a única recomendação ACIONÁVEL que
// classifyCampaignHealth já dá para CUSTO_PERDIDO.
enum AdsActionType {
  PAUSE_CAMPAIGN

  @@schema("marketplace_ads")
}

// PENDING é o único estado em que a ação AINDA NÃO foi executada — mesmo
// racional de EnrollmentStatus (Promotion Intelligence)/StockMovementAuditEvent
// (Hub de Provas): uma sugestão nasce persistida, nunca em memória, porque
// quem a gera (AdsAlertingService, rodando num cron) não é quem a resolve
// (o usuário, numa requisição HTTP futura). CONFIRMED é um estado
// transitório interno (marcado no instante em que o usuário confirma, antes
// da chamada ao provider resolver) — nunca fica visível como "pendente de
// nada" por muito tempo; resolve para APPLIED ou FAILED na mesma chamada.
enum AdsActionStatus {
  PENDING
  CONFIRMED
  APPLIED
  REJECTED
  FAILED

  @@schema("marketplace_ads")
}

// Fase 4 (sugestão via IA). Distingue quem originou a sugestão — não muda
// NADA no fluxo de aprovação/aplicação (AdsActionDispatcherService trata as
// duas origens de forma idêntica, sempre exigindo confirmação humana), é só
// trilha de auditoria: útil para o admin (e para qualquer revisão futura)
// saber se uma decisão passada veio de um threshold determinístico ou de um
// modelo de linguagem, que têm perfis de confiabilidade diferentes.
enum AdsActionSource {
  RULE_BASED
  AI

  @@schema("marketplace_ads")
}

model AdsActionSuggestion {
  id         String        @id @default(uuid())
  tenantId   String
  campaignId String
  campaign   AdsCampaign   @relation(fields: [campaignId], references: [id])
  actionType AdsActionType
  status     AdsActionStatus @default(PENDING)
  // Texto explicativo — mesmo `recommendation` já calculado por
  // classifyCampaignHealth no momento da sugestão (não recalculado depois).
  reason         String
  suggestedAt    DateTime  @default(now())
  resolvedAt     DateTime?
  // Auditoria: quem confirmou/rejeitou — nunca aplicado automaticamente sem
  // um usuário por trás (é o próprio Safety Lock).
  resolvedByUserId String?
  failureReason    String?

  // --- Fase 4 (sugestão via IA) ---
  source AdsActionSource @default(RULE_BASED)
  // Só preenchido quando source = AI. 0-1, devolvido pelo modelo — nunca
  // usado para decidir nada no backend (o Safety Lock não fica mais fraco
  // com confidence alta), só para o admin priorizar o que revisar primeiro
  // na fila e para auditoria futura.
  confidenceScore Float?
  // Só preenchido quando source = AI: contexto quantitativo que embasou a
  // sugestão (tendência de ROAS, targetRoas usado, delta sugerido...) — só
  // para leitura humana ao lado da sugestão, nunca reprocessado pelo
  // dispatcher. Também é o ponto de extensão natural para parâmetros de
  // ações futuras (ex.: REDUCE_BID.bidAdjustmentPct) sem nova migração.
  metadata Json?

  @@index([tenantId, status])
  @@index([campaignId, actionType, status])
  @@map("ads_action_suggestions")
  @@schema("marketplace_ads")
}

// ============================================================================
// Tagging (Sprint 28, benchmark Tiny ERP 28/07/2026, docs/tiny-erp-benchmark-analysis.md,
// seção 4/Fase 0) — sistema de marcadores genérico, reaproveitável em
// Produtos, Pedidos e Contas (hoje: FixedExpense — Contas a Pagar chega na
// Fase 1 e ganha o mesmo tratamento quando existir). Schema PRÓPRIO
// ("tagging"), não emprestado de nenhum módulo de domínio: é
// deliberadamente neutro, porque nenhuma das entidades marcáveis é "dona"
// do conceito de tag.
// ============================================================================

// Conjunto FECHADO e interno (ao contrário de channelCode, que é aberto/
// externo e por isso String) — cada novo tipo marcável é uma decisão de
// produto nossa, nunca um dado vindo de fora. Cresce por migration mesmo,
// mas isso é raro (adicionar um novo tipo de entidade marcável não é um
// evento frequente, diferente de "canal novo").
enum TaggableEntityType {
  PRODUCT
  ORDER
  FIXED_EXPENSE
  // Benchmark Tiny ERP (28/07/2026, Fase 1) — módulo novo de Contas a Pagar
  // (financial_intelligence.AccountsPayable), diferente de FIXED_EXPENSE.
  ACCOUNTS_PAYABLE

  @@schema("tagging")
}

model Tag {
  id       String  @id @default(uuid())
  tenantId String
  name     String
  // Hex opcional (ex.: "#00F0FF") — só para diferenciação visual na UI,
  // NUNCA usado em nenhuma lógica de negócio (mesmo racional de
  // OrderStatusMeta.badgeClass no frontend: cor é apresentação, não dado).
  color String?

  createdAt DateTime @default(now())

  assignments TagAssignment[]

  // Nome único por tenant — evita duas tags "Frágil" e "frágil" cadastradas
  // por acidente pelo mesmo usuário (comparação exata, não case-insensitive:
  // Postgres/Prisma não oferecem unique case-insensitive nativo sem extensão
  // extra, e o custo de adicionar uma agora não se paga pelo valor).
  @@unique([tenantId, name])
  @@map("tags")
  @@schema("tagging")
}

// A ligação genérica entre uma Tag e QUALQUER entidade marcável — o mesmo
// papel que StockLedgerEntry.skuCode cumpre para o catálogo: referência
// SOLTA (entityId como String, sem FK de banco), porque a entidade
// referenciada vive em outro schema/módulo (Product em catalog, Order em
// orders, FixedExpense em financial_intelligence) e este módulo não pode
// (nem deve) depender deles. Quem resolve entityId -> entidade de verdade é
// sempre o módulo dono, nunca este.
model TagAssignment {
  id       String @id @default(uuid())
  // Denormalizado (não vem só via Tag.tenantId) — mesmo racional de
  // StockMovementAuditEventItem: RLS precisa filtrar esta tabela
  // diretamente por tenantId, sem depender de um JOIN até Tag.
  tenantId String

  tagId String
  tag   Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  entityType TaggableEntityType
  entityId   String

  createdAt DateTime @default(now())

  // Uma tag não pode ser aplicada duas vezes à mesma entidade — idempotência
  // do "atribuir" (ver TaggingService.assign).
  @@unique([tenantId, tagId, entityType, entityId])
  // Consulta mais comum: "quais tags esta entidade tem" (reverse lookup, ex.:
  // badge de tags na tela de produto/pedido).
  @@index([tenantId, entityType, entityId])
  @@map("tag_assignments")
  @@schema("tagging")
}

// ============================================================================
// Procurement — Ordem de Compra (Fase 1, benchmark Tiny ERP, 28/07/2026).
// Fecha o ciclo do ReplenishmentAdvisor (logistics-fulfillment): sugere
// reposição -> humano decide comprar -> PurchaseOrder registra a compra ->
// ao "receber" (POST .../receive), credita estoque (via
// StockMovementAuditEventService.receivePurchase, tipo PURCHASE_RECEIPT) E
// gera AccountsPayable automaticamente — os dois pontos de integração cross-
// schema, sempre por PORTA exportada (STOCK_RECEIPT_WRITER,
// ACCOUNTS_PAYABLE_WRITER em shared/contracts/tokens.ts), nunca importando a
// classe concreta de outro módulo. Schema Postgres PRÓPRIO (não reaproveita
// logistics_fulfillment nem financial_intelligence): é um bounded context
// genuinamente diferente dos dois (o processo de COMPRAR, não o de mover
// estoque nem o de contas financeiras) — ver docs/procurement-architecture.md.
// ============================================================================

enum PurchaseOrderStatus {
  ABERTO // criado, nada ainda decidido — pode avançar ou ser cancelado
  ANDAMENTO // em negociação/trânsito com o fornecedor — pode avançar (receber) ou ser cancelado
  ATENDIDO // recebida — TERMINAL, já creditou estoque e gerou conta a pagar, nunca cancela depois disso
  CANCELADO // TERMINAL — nunca chegou a ser recebida

  @@schema("procurement")
}

model PurchaseOrder {
  id       String              @id @default(uuid())
  tenantId String
  status   PurchaseOrderStatus @default(ABERTO)

  // Referências SOLTAS (não FK) — supplierId vive em catalog, warehouseId em
  // logistics_fulfillment, ambos schemas diferentes deste (Prisma
  // multiSchema não modela @relation cross-schema). Validadas por tenant na
  // camada de aplicação via SUPPLIER_REPOSITORY/WAREHOUSE_REPOSITORY
  // injetados — mesmo padrão de AccountsPayable.supplierId/TagAssignment.entityId.
  supplierId  String
  warehouseId String // depósito de DESTINO — onde o estoque comprado vai entrar ao receber

  // Data de vencimento do pagamento — captura a condição comercial acordada
  // com o fornecedor NO MOMENTO da compra (não deriva de Supplier.paymentTerms,
  // que é texto livre no MVP e não parseável em data). Usada para preencher
  // AccountsPayable.dueDate quando a ordem é recebida.
  paymentDueDate DateTime

  notes String?

  // Preenchidos só por PurchaseOrderService.receive() — nunca setados em
  // create()/advance(), mesmo racional de AccountsPayable.paidAt.
  invoiceNumber String?
  receivedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PurchaseOrderItem[]

  // Consulta mais comum: "minhas ordens de compra" por status.
  @@index([tenantId, status])
  @@map("purchase_orders")
  @@schema("procurement")
}

model PurchaseOrderItem {
  id       String @id @default(uuid())
  // Denormalizado (não só via PurchaseOrder.tenantId) — RLS precisa filtrar
  // esta tabela diretamente, mesmo padrão de StockMovementAuditEventItem/
  // TagAssignment.
  tenantId String

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  // Referência SOLTA a catalog.Product — mesmo padrão de StockLedgerEntry.skuCode.
  skuCode  String
  quantity Int // sempre positivo — a intenção de compra nunca é negativa
  unitCost Decimal @db.Decimal(12, 2)
  // Campo do modelo do Tiny ("ipi") — imposto por item, opcional (nem todo
  // fornecedor/operação tem IPI destacado). Somado ao custo no cálculo do
  // valor total (ver domain/purchase-order.entity.ts, computeTotalAmount).
  ipi Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, purchaseOrderId])
  @@map("purchase_order_items")
  @@schema("procurement")
}

// ============================================================================
// Lista de Preços — motor de atacado/canal (Fase 2, benchmark Tiny ERP,
// 28/07/2026). Absorve o CONCEITO do Tiny (ListaPrecoResponseModel +
// ExcecaoListaPrecoModel), não a implementação exata: aqui é só um
// percentual de ajuste (acréscimo/desconto) + exceções pontuais por
// produto, sem nenhuma integração automática com o motor de repricing já
// existente (PricingStrategist) — o `basePrice` é sempre informado por quem
// consulta (ver PriceListService.resolvePrice), nunca lido de um campo
// "preço atual" que o Kyneti não tem (preço é sempre calculado sob demanda
// por canal, nunca um valor único gravado no Product). Ver
// docs/price-lists-architecture.md. Mesmo schema do Product (catalog) —
// é configuração comercial em cima do catálogo, mesmo bounded context de
// Packaging/TaxProfile/Supplier.
// ============================================================================

model PriceList {
  id       String  @id @default(uuid())
  tenantId String
  name     String // ex.: "Atacado", "Revenda", "Black Friday"
  // Percentual aplicado sobre o basePrice informado por quem consulta —
  // positivo = acréscimo, negativo = desconto (equivalente ao
  // `acrescimoDesconto` do Tiny, um único campo com sinal em vez de dois
  // conceitos separados). Ver domain/price-list.entity.ts, isValidAdjustmentPct.
  adjustmentPct Float
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  exceptions PriceListException[]

  @@index([tenantId])
  @@map("price_lists")
  @@schema("catalog")
}

model PriceListException {
  id       String @id @default(uuid())
  // Denormalizado (não só via PriceList.tenantId) — RLS precisa filtrar
  // esta tabela diretamente, mesmo padrão de PurchaseOrderItem/TagAssignment.
  tenantId String

  priceListId String
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  // FK real (não referência solta) — PriceList vive no MESMO schema que
  // Product (catalog), diferente de PurchaseOrder/AccountsPayable que
  // referenciam entidades de outros schemas.
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  overridePrice Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // No máximo uma exceção por produto dentro de uma mesma lista.
  @@unique([priceListId, productId])
  @@index([tenantId, priceListId])
  @@map("price_list_exceptions")
  @@schema("catalog")
}

// ============================================================================
// Emissão de NF-e (Fase 3, benchmark Tiny ERP, 28/07/2026) — integração com
// o Focus NFe (parceiro fiscal escolhido na Fase 0, ver
// docs/tiny-erp-benchmark-analysis.md, seção 1.1). Ver
// docs/fiscal-nfe-architecture.md para o desenho completo (por que MVP usa
// defaults de Simples Nacional, por que o destinatário é sempre um
// snapshot imutável, por que a emissão automática é opt-in).
// ============================================================================

enum FiscalInvoiceStatus {
  PENDENTE // criada no Kyneti, ainda não enviada ao Focus NFe (ou falhou antes de enviar)
  PROCESSANDO // aceita pelo Focus NFe, aguardando autorização da SEFAZ (assíncrono)
  AUTORIZADA
  ERRO
  CANCELADA

  @@schema("fiscal")
}

enum FiscalEnvironment {
  HOMOLOGACAO // notas de teste, sem valor fiscal — usar até a operação em produção estar validada
  PRODUCAO

  @@schema("fiscal")
}

// Configuração do EMITENTE — um registro por tenant (mesmo padrão de
// singleton por tenant de CatalogSettings). Contém os dados que a Focus NFe
// exige para o emitente da nota (CNPJ, endereço, regime tributário) e a
// credencial da API (token, sempre criptografado em repouso via
// CredentialEncryptionService — mesmo padrão de ShopeeConnection/
// MercadoLivreConnection/OlistConnection).
model FiscalSettings {
  tenantId String @id

  cnpj              String
  razaoSocial       String
  nomeFantasia      String?
  inscricaoEstadual String
  // Valores possíveis (API Focus NFe): 1=Simples Nacional, 2=Simples
  // Nacional c/ excesso de sublimite, 3=Regime Normal. Default 1 — decisão
  // 28/07/2026 (ver docs/fiscal-nfe-architecture.md): MVP assume Simples
  // Nacional, o regime mais comum para vendedor multicanal de porte
  // pequeno/médio. Revisão do contador necessária se o tenant for Regime
  // Normal.
  regimeTributario Int @default(1)

  logradouro String
  numero     String
  bairro     String
  municipio  String
  uf         String
  cep        String
  telefone   String?

  // Criptografado em repouso — nunca lido/gravado em texto puro fora de
  // FiscalSettingsService (ver CredentialEncryptionService).
  focusNfeTokenEnc String
  environment      FiscalEnvironment @default(HOMOLOGACAO)

  // Emissão automática ao pedido entrar em APROVADO — opt-in, default
  // false. MVP começa manual por segurança (decisão do usuário, 28/07/2026):
  // um documento fiscal tem consequência legal, então o padrão é sempre
  // exigir uma ação humana até o tenant ativar explicitamente a automação.
  autoEmitOnApproval Boolean @default(false)

  // Série de NF-e usada pelo Kyneti — DEVE ser diferente de qualquer série já
  // usada pelo mesmo CNPJ em outro emissor (ex.: Olist), para não colidir
  // numeração perante a SEFAZ. Nullable: se ausente, deixa a Focus NFe usar a
  // série configurada no painel deles.
  nfeSerie Int?

  // Naturezas de Operação (Projeto Estruturante 4, benchmark Bling ERP,
  // 29/07/2026, ver docs/naturezas-operacao-architecture.md) — natureza
  // usada quando `EmitInvoiceInput.naturezaOperacaoId` não é informado no
  // momento da emissão. Nullable: ausente = comportamento histórico do MVP
  // (CFOP hardcoded de revenda Simples Nacional, `resolveCfop` em
  // tax-code-resolver.ts) — nenhum tenant é obrigado a configurar isto.
  defaultNaturezaOperacaoId String?
  defaultNaturezaOperacao   NaturezaOperacao? @relation(fields: [defaultNaturezaOperacaoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fiscal_settings")
  @@schema("fiscal")
}

// Naturezas de Operação (Projeto Estruturante 4, benchmark Bling ERP,
// 29/07/2026 — ver docs/bling-erp-benchmark-analysis.md, seção 2,
// `NaturezasOperacoesDadosDTO`, e docs/naturezas-operacao-architecture.md
// para o desenho completo). Generaliza o CFOP hardcoded de
// `tax-code-resolver.ts` (resolveCfop, só revenda Simples Nacional) para um
// cadastro configurável por tenant.
//
// AVISO DE HONESTIDADE (mesmo racional de FiscalMarketplaceIntermediary): o
// Kyneti NUNCA fabrica um código CFOP para um cenário que não verificou (ex.:
// substituição tributária, industrialização própria) — o tenant (ou seu
// contador) preenche os códigos de uma natureza customizada conscientemente.
// O único CFOP "de fábrica" continua sendo o fallback hardcoded em
// tax-code-resolver.ts (5102/6102/5202/6202, Simples Nacional revenda simples),
// usado quando NENHUMA natureza é configurada/selecionada — zero mudança de
// comportamento para quem não usa este cadastro.
model NaturezaOperacao {
  id       String @id @default(uuid())
  tenantId String

  nome String // ex.: "Venda de mercadoria - Simples Nacional (padrão)"

  // CFOP de VENDA — usado para finalidade NORMAL/COMPLEMENTAR/AJUSTE (mesmo
  // racional já documentado em tax-code-resolver.ts: só DEVOLUCAO muda o
  // CFOP; Complementar/Ajuste mantêm o CFOP da operação original).
  cfopVendaInterno       String // operação DENTRO do estado do emitente
  cfopVendaInterestadual String // operação para OUTRO estado

  // CFOP de DEVOLUÇÃO (finalidade DEVOLUCAO) — opcional. Ausente = usa o
  // fallback padrão (5202/6202) via resolveCfopFromNatureza, mesmo valor
  // histórico do MVP.
  cfopDevolucaoInterno       String?
  cfopDevolucaoInterestadual String?

  isActive Boolean @default(true)

  fiscalSettings FiscalSettings[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, nome])
  @@index([tenantId, isActive])
  @@map("naturezas_operacao")
  @@schema("fiscal")
}

// Uma linha por TENTATIVA de emissão de nota para um pedido — reemissão após
// ERRO cria uma nova linha (nunca sobrescreve uma tentativa anterior),
// preservando o histórico completo. focusRef é o que vai no `?ref=` da API
// Focus NFe: só pode ser reaproveitado enquanto a tentativa anterior não foi
// autorizada (ver domain/fiscal-invoice.entity.ts, canEmit).
model FiscalInvoice {
  id       String @id @default(uuid())
  tenantId String

  // Referência SOLTA (não FK) para orders.Order — schemas diferentes, mesmo
  // padrão de PurchaseOrder.supplierId.
  orderId String

  focusRef String @unique

  status      FiscalInvoiceStatus @default(PENDENTE)
  environment FiscalEnvironment

  // Snapshot do destinatário NO MOMENTO DA EMISSÃO — nunca reconsultado
  // depois. Um documento fiscal autorizado é imutável; se o pedido mudar de
  // endereço depois, isso NUNCA deveria alterar uma nota já emitida.
  // destEndereco: { logradouro, numero, bairro, municipio, uf, cep, pais }.
  destNome      String
  destDocumento String // CPF ou CNPJ, sem formatação
  destEndereco  Json
  destTelefone  String?

  // Preenchidos só quando status = AUTORIZADA (resposta da consulta/gatilho
  // Focus NFe).
  nfeNumber String?
  nfeSeries String?
  accessKey String? // chave de acesso da NFe (44 dígitos)
  xmlUrl    String?
  danfeUrl  String?

  errorCode    String?
  errorMessage String?

  cancelReason String?
  requestedAt  DateTime  @default(now())
  authorizedAt DateTime?
  cancelledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, orderId])
  @@index([tenantId, status])
  @@map("fiscal_invoices")
  @@schema("fiscal")
}

// Grupo G da NF-e ("Identificação do Intermediador da Transação", NT
// 2020.006/Ajuste SINIEF 21-22/2020) — obrigatório em toda venda feita
// através de marketplace (Mercado Livre, Shopee, Amazon, Magalu, TikTok
// Shop). Benchmark Bling (29/07/2026, ver
// docs/bling-erp-benchmark-analysis.md, seção 1.4): o Kyneti emitia NF-e para
// pedido de marketplace SEM esse grupo — gap crítico de compliance, não só
// "recurso faltando".
//
// Uma linha por CANAL (não um campo solto em FiscalSettings) porque o CNPJ
// do intermediador é diferente por canal (o CNPJ é da PLATAFORMA — Mercado
// Livre, Shopee etc. — nunca do vendedor) e porque nem todo canal é de fato
// um "intermediador" no sentido da NT (ex.: Nuvemshop é a loja própria do
// vendedor, não um marketplace de terceiros — por isso não tem uma linha
// aqui a menos que o tenant configure explicitamente).
//
// AVISO DE HONESTIDADE: o Kyneti NÃO pré-preenche o CNPJ de nenhum
// marketplace. CNPJs de intermediador circulam em bases públicas (ex.:
// Mercado Livre é comumente associado ao CNPJ da EBAZAR.COM.BR LTDA,
// 03.007.331/0001-41), mas nenhuma fonte oficial do próprio marketplace
// confirma isso como "o CNPJ certo para o campo intermediador" — o tenant (ou
// seu contador) preenche esse valor conscientemente. idCadIntTran é o
// login/identificador do PRÓPRIO vendedor dentro daquele marketplace (não é
// um valor global do canal, é por tenant).
model FiscalMarketplaceIntermediary {
  id       String @id @default(uuid())
  tenantId String

  // Mesmo vocabulário de Order.channelCode/OrderFiscalData.channelCode —
  // string livre, não enum, canal novo é dado.
  channelCode String

  cnpj          String // CNPJ do intermediador (a PLATAFORMA), só dígitos
  idCadIntTran  String // identificador do vendedor cadastrado na plataforma (ex.: nickname/login no marketplace)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, channelCode])
  @@map("fiscal_marketplace_intermediaries")
  @@schema("fiscal")
}

// ============================================================================
// Publicar anúncio novo em marketplace (Fase 4, benchmark Tiny ERP,
// 28/07/2026 — ver docs/tiny-erp-benchmark-analysis.md, seção 1.7, e
// docs/marketplace-listing-publish-architecture.md). Bounded context PRÓPRIO
// porque o dado aqui é específico de CANAL (categoria do ML != categoria da
// Shopee para o mesmo produto), diferente de catalog.ProductCategory (que é
// a árvore interna, uma só, compartilhada entre canais).
// ============================================================================

enum ListingPublicationStatus {
  PENDENTE // criado, ainda não confirmado pelo canal (não deveria durar — createListing é síncrono)
  PUBLICADO
  ERRO

  @@schema("marketplace_publishing")
}

// Mapeia UMA categoria interna (catalog.ProductCategory) para a categoria de
// UM canal específico — espelha "mapear categorias do e-commerce" do
// Tiny/Olist. categoryId é referência SOLTA (não FK — catalog é outro
// schema Postgres, mesmo padrão de PurchaseOrder.supplierId/FiscalInvoice.orderId).
model ChannelCategoryMapping {
  id       String @id @default(uuid())
  tenantId String

  categoryId String // solto, aponta para catalog.ProductCategory.id

  marketplaceCode String // "MERCADO_LIVRE" | "SHOPEE" — string, não enum, mesmo racional de ChannelListing.channelCode

  externalCategoryId   String // ex.: category_id do Mercado Livre (MLBxxxx) ou category_id da Shopee
  externalCategoryName String // só para exibição na UI — nunca usado para decidir nada

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, categoryId, marketplaceCode])
  @@index([tenantId, marketplaceCode])
  @@map("channel_category_mappings")
  @@schema("marketplace_publishing")
}

// Uma linha por TENTATIVA de publicação (mesmo padrão append-only de
// FiscalInvoice) — nunca sobrescrita. productId/skuCode são referência
// SOLTA + denormalizada (o produto pode mudar ou ser removido depois; a
// trilha de "o que foi enviado para o canal" precisa sobreviver a isso,
// mesmo racional de ProductAuditLog.skuCode).
model ListingPublication {
  id       String @id @default(uuid())
  tenantId String

  productId String
  skuCode   String

  marketplaceCode String

  status ListingPublicationStatus @default(PENDENTE)

  externalListingId String? // id do anúncio criado no canal — preenchido só quando status = PUBLICADO

  // Snapshot exato do payload enviado ao canal (categoria + atributos +
  // preço + etc no momento da publicação) — auditoria/depuração, nunca
  // relido pelo domínio para decidir nada.
  requestPayload Json

  errorMessage String?

  requestedAt DateTime  @default(now())
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, productId])
  @@index([tenantId, marketplaceCode, status])
  @@map("listing_publications")
  @@schema("marketplace_publishing")
}

// ============================================================================
// Ordens de Produção (Projeto Estruturante 1, benchmark Bling ERP,
// 29/07/2026) — ver docs/bling-erp-benchmark-analysis.md, seção 1.1, e
// docs/production-architecture.md. Schema Postgres PRÓPRIO: "produzir" é um
// processo distinto de cadastro de produto (catalog.ProductStructureComponent,
// a BOM) ou de movimentação de estoque (logistics_fulfillment) — workflow
// próprio, mesmo racional de procurement (Fase 1). warehouseIds são
// referências SOLTAS a logistics_fulfillment.Warehouse (schema diferente,
// mesmo padrão de PurchaseOrder.warehouseId).
// ============================================================================

enum ProductionOrderStatus {
  RASCUNHO // criado, componentes resolvidos via snapshot da BOM — nenhum estoque se moveu ainda
  EM_ANDAMENTO // produção em curso (uso operacional/informativo, sem efeito de estoque)
  CONCLUIDA // TERMINAL — já debitou componentes e creditou o produto acabado (Hub de Provas, PRODUCTION_OUTPUT)
  CANCELADA // TERMINAL — nunca chegou a concluir, nenhum estoque foi movido

  @@schema("production")
}

model ProductionOrder {
  id       String                @id @default(uuid())
  tenantId String
  status   ProductionOrderStatus @default(RASCUNHO)

  parentSkuCode String // produto acabado a ser produzido (o kit, Product.isKit = true)
  quantity      Int // quantidade do produto acabado a produzir — sempre inteira e positiva

  sourceWarehouseId      String // depósito de onde os componentes SAEM (débito)
  destinationWarehouseId String // depósito onde o produto acabado ENTRA (crédito) — pode ser igual ao source

  notes String?

  // Preenchido só por ProductionOrderService.conclude() — nunca setado em
  // create()/start(), mesmo racional de PurchaseOrder.receivedAt.
  concludedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  components ProductionOrderComponent[]

  @@index([tenantId, status])
  @@map("production_orders")
  @@schema("production")
}

// Snapshot da BOM (catalog.ProductStructureComponent) no momento da criação
// da ordem — mesmo racional de StockMovementAuditEventItem.expectedQuantity/
// OrderItem.costPriceUsed: se a estrutura do produto mudar depois, uma ordem
// já criada não é afetada. totalQuantity já vem pré-calculado
// (quantityPerUnit * ProductionOrder.quantity) para não recalcular na hora
// de montar as linhas de débito na conclusão.
model ProductionOrderComponent {
  id       String @id @default(uuid())
  // Denormalizado (não só via ProductionOrder.tenantId) — RLS precisa
  // filtrar esta tabela diretamente, mesmo padrão de PurchaseOrderItem.
  tenantId String

  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  componentSkuCode String
  quantityPerUnit  Decimal @db.Decimal(12, 3)
  totalQuantity    Decimal @db.Decimal(12, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productionOrderId, componentSkuCode])
  @@index([tenantId, productionOrderId])
  @@map("production_order_components")
  @@schema("production")
}

// ============================================================================
// Vendedores + Comissão (Projeto Estruturante 3, benchmark Bling ERP,
// 29/07/2026). Ver docs/sellers-architecture.md.
//
// Bounded context PRÓPRIO (schema Postgres "sellers"), mesmo racional de
// production/procurement: "vendedor + comissão" é um conceito distinto de
// cadastro de produto ou de pedido, mesmo cruzando os dois. Consumido pelo
// Orders (OrderItem.vendedorId, CommissionService) via porta compartilhada
// SELLER_READER (shared/contracts) — nunca a classe concreta.
// ============================================================================
model Vendedor {
  id       String @id @default(uuid())
  tenantId String

  name  String
  email String?

  // Alíquota padrão de comissão deste vendedor (%) — snapshot capturado em
  // OrderItem.comissaoAliquotaPct no momento da atribuição (ver
  // CommissionService.assignVendedor) — mudar a alíquota aqui depois NUNCA
  // recalcula itens já atribuídos, mesmo racional de ProductionOrderComponent
  // (snapshot da BOM) e OrderItem.costPrice (snapshot do custo).
  aliquotaComissaoPct Decimal @db.Decimal(5, 2)

  // Desconto máximo (%) que este vendedor pode conceder numa venda —
  // informativo nesta rodada (gap documentado em
  // docs/sellers-architecture.md): nenhum fluxo de venda/checkout valida
  // isso ainda.
  descontoMaximoPct Decimal? @db.Decimal(5, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("vendedores")
  @@schema("sellers")
}
