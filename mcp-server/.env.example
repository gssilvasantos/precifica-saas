# Kyneti MCP Server — variáveis de ambiente
#
# NENHUMA dessas variáveis deve ser commitada ou digitada em chat. Configure-as
# direto no painel do Render (Environment) ao criar/editar este serviço.

# URL base da API do Kyneti (sem barra no final).
KYNETI_API_BASE_URL=https://api.kyneti.com.br/api

# Credenciais do usuário de SERVIÇO (role VIEWER, criado no painel Equipe do
# Kyneti — ver README.md "Passo 1"). Nunca reaproveite a conta pessoal do
# admin: crie uma conta dedicada, só-leitura, com os módulos abaixo.
KYNETI_SERVICE_EMAIL=
KYNETI_SERVICE_PASSWORD=

# Caso o e-mail da conta de serviço exista em mais de um tenant (não deveria
# acontecer numa conta dedicada), informe o tenantId explicitamente.
KYNETI_SERVICE_TENANT_ID=

# Segredo compartilhado que protege este servidor MCP — qualquer chamada sem
# o header "Authorization: Bearer <MCP_SHARED_SECRET>" é rejeitada com 401.
# Gere um valor aleatório longo (ex.: openssl rand -hex 32) e use o MESMO
# valor na configuração do conector customizado no Claude.
MCP_SHARED_SECRET=

# Porta HTTP (o Render injeta PORT automaticamente; deixe vazio em produção).
PORT=8787
